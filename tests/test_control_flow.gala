// test_control_flow.gala: if / else if / else, while, for, break, continue, return in loops.
// No shadowing anywhere: every name is unique within its scope chain.

import "core/core.gala";

failures := 0;
marks := 0;

fn check(ok: bool, name: string) {
    if !ok {
        failures += 1;
        println("FAIL:", name);
    }
}

struct Box { v: i32 }

fn box_val(b: Box): i32 { return b.v; }
fn is_pos(v: i32): bool { return v > 0; }
fn mark(): bool {
    marks += 1;
    return true;
}

// ---------- if / else if / else ----------

fn classify(v: i32): i32 {
    result: i32 = 0;
    if v < 0 {
        result = -1;
    } else if v == 0 {
        result = 0;
    } else if v < 10 {
        result = 1;
    } else {
        result = 2;
    }
    return result;
}

fn nested_if(a, b: bool): i32 {
    r: i32 = 0;
    if a {
        if b {
            r = 3;
        } else {
            r = 2;
        }
    } else {
        if b {
            r = 1;
        }
    }
    return r;
}

fn test_if() {
    check(classify(-5) == -1, "if branch");
    check(classify(0) == 0, "first else-if");
    check(classify(7) == 1, "second else-if");
    check(classify(50) == 2, "else branch");

    check(nested_if(true, true) == 3, "nested: true/true");
    check(nested_if(true, false) == 2, "nested: true/false");
    check(nested_if(false, true) == 1, "nested: false/true");
    check(nested_if(false, false) == 0, "nested: false/false, no else");

    paren_hit: i32 = 0;
    if (paren_hit == 0) { paren_hit = 1; }
    check(paren_hit == 1, "parenthesised condition");

    cmp_x: i32 = 5;
    cmp_hit: i32 = 0;
    if cmp_x > 1 && cmp_x < 10 || cmp_x == 100 { cmp_hit = 1; }
    check(cmp_hit == 1, "compound condition");

    // only the first true branch runs, later conditions aren't evaluated
    marks = 0;
    chain_hit: i32 = 0;
    if false {
        chain_hit = 1;
    } else if mark() {
        chain_hit = 2;
    } else if mark() {
        chain_hit = 3;
    }
    check(chain_hit == 2 && marks == 1, "else-if chain stops at first true branch");
}

fn test_empty_blocks() {
    empty_flag := true;
    if empty_flag { } else { }
    while false { }
    check(empty_flag, "empty blocks");
}

// ---------- struct literals inside conditions ----------

fn test_struct_lit_in_headers() {
    hit: i32 = 0;
    if box_val(Box{v = 1}) == 1 { hit += 1; }
    if box_val(Box{v = 0}) == 1 {
        hit += 100;
    } else if box_val(Box{v = 2}) == 2 {
        hit += 10;
    }
    check(hit == 11, "struct literal in call args, if and else-if");

    while box_val(Box{v = hit}) < 12 { hit += 1; }
    check(hit == 12, "struct literal in while condition");

    lit_sum: i32 = 0;
    for item in [2]i32{1, 2} { lit_sum += item; }
    check(lit_sum == 3, "array literal as for iterable");

    paren_total: i32 = 0;
    if (Box{v = 1}).v == 1 { paren_total = 1; }
    check(paren_total == 1, "parenthesised struct literal in condition");
}

// ---------- while ----------

fn test_while() {
    i: i32 = 0;
    total: i32 = 0;
    while i < 5 {
        total += i;
        i += 1;
    }
    check(total == 10, "basic while");

    while false { total = -1; }
    check(total == 10, "while false never runs");

    stop_at: i32 = 0;
    while true {
        if stop_at == 7 { break; }
        stop_at += 1;
    }
    check(stop_at == 7, "break out of while true");

    k: i32 = 0;
    odd_sum: i32 = 0;
    while k < 10 {
        k += 1;
        if k % 2 == 0 { continue; }
        odd_sum += k;
    }
    check(odd_sum == 25, "continue skips the rest of the body");

    pos_count: i32 = 3;
    while is_pos(pos_count) { pos_count -= 1; }
    check(pos_count == 0, "call as while condition");

    outer: i32 = 0;
    hits: i32 = 0;
    while outer < 3 {
        inner: i32 = 0;
        while true {
            if inner == 2 { break; }
            inner += 1;
            hits += 1;
        }
        outer += 1;
    }
    check(hits == 6 && outer == 3, "break only leaves the inner loop");
}

// ---------- for ----------

fn find_first_over(xs: []i32, limit: i32): i32 {
    for v in xs {
        if v > limit { return v; }
    }
    return -1;
}

fn count_until(limit: i32): i32 {
    c: i32 = 0;
    while c < 100 {
        c += 1;
        if c >= limit { return c; }
    }
    return -1;
}

fn test_for() {
    arr := [4]i32{1, 2, 3, 4};
    sum: i32 = 0;
    for v in arr { sum += v; }
    check(sum == 10, "for over an array");

    slice_sum: i32 = 0;
    for sv in arr[1:3] { slice_sum += sv; }
    check(slice_sum == 5, "for over a sub-slice");

    partial: i32 = 0;
    for pv in arr {
        if pv == 3 { break; }
        partial += pv;
    }
    check(partial == 3, "break in for");

    evens: i32 = 0;
    for ev in arr {
        if ev % 2 == 1 { continue; }
        evens += ev;
    }
    check(evens == 6, "continue in for");

    pairs: i32 = 0;
    for oa in arr {
        for ob in arr {
            if ob > oa { break; }
            pairs += 1;
        }
    }
    check(pairs == 10, "break only leaves the inner for");

    mixed: i32 = 0;
    for ma in arr {
        wh: i32 = 0;
        while wh < ma {
            wh += 1;
            if wh == 2 { break; }
            mixed += 1;
        }
    }
    check(mixed == 4, "while inside for, break inside the while");

    items := [5]i32{3, 8, 12, 20, 1};
    check(find_first_over(items[:], 10) == 12, "return from inside a for");
    check(find_first_over(items[:], 50) == -1, "for finishes without returning");
    check(count_until(5) == 5, "return from inside a while");
    check(count_until(500) == -1, "while finishes without returning");
}

fn main() {
    test_if();
    test_empty_blocks();
    test_struct_lit_in_headers();
    test_while();
    test_for();

    if failures == 0 {
        println("control flow: all passed");
    } else {
        println("control flow: FAILED");
    }
}
