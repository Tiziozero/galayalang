// net_windows.gala: Winsock 2 implementation of the net API.
// Types, error kinds and helpers live in net_common.gala; import both.
// Same functions and signatures as net_posix.gala.
//
// Winsock has no MSG_NOSIGNAL (and no SIGPIPE), so nothing to suppress.
// net_init() is called lazily by connect/listen, but it is not thread-safe:
// call it once at startup if you use threads.

@link("/DEFAULTLIB:ws2_32.lib")
import "core/core_windows.gala";

forward import "core/net_common.gala";

// ============================================================
// Bindings
// ============================================================

// SOCKET = UINT_PTR (u64 on x64), INVALID_SOCKET = ~0 (-1 as i64).
extern fn socket(af: i32, socket_type: i32, protocol: i32): u64;
extern fn connect(s: u64, _addr: ^byte, addrlen: i32): i32;
extern fn bind(s: u64, _addr: ^byte, addrlen: i32): i32;
extern fn listen(s: u64, backlog: i32): i32;
extern fn accept(s: u64, _addr: ^byte, addrlen: ^i32): u64;
extern fn send(s: u64, buffer: ^byte, length: i32, flags: i32): i32;
extern fn recv(s: u64, buffer: ^byte, length: i32, flags: i32): i32;
extern fn shutdown(s: u64, how: i32): i32;
extern fn closesocket(s: u64): i32;
extern fn setsockopt(s: u64, level: i32, option: i32, value: ^byte, value_len: i32): i32;

extern fn htons(value: u16): u16;
extern fn htonl(value: u32): u32;

extern fn WSAGetLastError(): i32;
extern fn WSAStartup(version: u16, data: ^WsaData): i32;
extern fn WSACleanup(): i32;


// ============================================================
// Constants
// ============================================================

AF_INET: i32 = 2;
SOCK_STREAM: i32 = 1;
IPPROTO_TCP: i32 = 6;

SOL_SOCKET: i32 = 65535;
SO_RCVTIMEO: i32 = 4102;

SHUT_RD: i32 = 0;
SHUT_WR: i32 = 1;
SHUT_RDWR: i32 = 2;

// Winsock error codes
WSAEINTR: i32 = 10004;
WSAEBADF: i32 = 10009;
WSAEACCES: i32 = 10013;
WSAEINVAL: i32 = 10022;
WSAEMFILE: i32 = 10024;
WSAEWOULDBLOCK: i32 = 10035;
WSAENOTSOCK: i32 = 10038;
WSAEAFNOSUPPORT: i32 = 10047;
WSAEADDRINUSE: i32 = 10048;
WSAEADDRNOTAVAIL: i32 = 10049;
WSAENETUNREACH: i32 = 10051;
WSAECONNABORTED: i32 = 10053;
WSAECONNRESET: i32 = 10054;
WSAENOBUFS: i32 = 10055;
WSAENOTCONN: i32 = 10057;
WSAESHUTDOWN: i32 = 10058;
WSAETIMEDOUT: i32 = 10060;
WSAECONNREFUSED: i32 = 10061;
WSAEHOSTUNREACH: i32 = 10065;
WSANOTINITIALISED: i32 = 10093;

// WSADATA is 408 bytes on x64; the fields are never accessed.
struct WsaData {
    data: [51]i64,
}


// ============================================================
// Error capture
// ============================================================

fn net_kind_from_wsa(e: i32): i32 {
    if e == WSAEINTR { return NET_ERR_INTERRUPTED; }
    if e == WSAETIMEDOUT || e == WSAEWOULDBLOCK { return NET_ERR_TIMEOUT; }
    if e == WSAECONNREFUSED { return NET_ERR_REFUSED; }
    if e == WSAEADDRINUSE { return NET_ERR_ADDR_IN_USE; }
    if e == WSAEADDRNOTAVAIL || e == WSAEAFNOSUPPORT { return NET_ERR_BAD_ADDRESS; }
    if e == WSAEACCES { return NET_ERR_ACCESS; }
    if e == WSAENETUNREACH || e == WSAEHOSTUNREACH { return NET_ERR_UNREACHABLE; }
    if e == WSAECONNRESET || e == WSAECONNABORTED || e == WSAENOTCONN || e == WSAESHUTDOWN {
        return NET_ERR_CLOSED;
    }
    if e == WSAEBADF || e == WSAENOTSOCK { return NET_ERR_INVALID_SOCKET; }
    if e == WSAEMFILE || e == WSAENOBUFS { return NET_ERR_RESOURCES; }
    if e == WSANOTINITIALISED { return NET_ERR_INIT; }
    if e == WSAEINVAL { return NET_ERR_BAD_ARG; }
    return NET_ERR_OTHER;
}

// Call this immediately after the failing Winsock call, before anything else.
fn net_fail(): NetError {
    e := WSAGetLastError();
    return net_error(net_kind_from_wsa(e), e);
}

fn net_bad_socket(): NetError {
    return net_error(NET_ERR_INVALID_SOCKET, 0);
}


// ============================================================
// Startup
// ============================================================

net_started: bool = false;

fn net_init(): NetError {
    if net_started {
        return net_no_error();
    }
    wsa := WsaData{data=[51]i64{}};
    rc := WSAStartup(cast(u16)514, &wsa);    // Winsock 2.2
    if rc != 0 {
        return net_error(NET_ERR_INIT, rc);
    }
    net_started = true;
    return net_no_error();
}

fn net_cleanup() {
    if net_started {
        WSACleanup();
        net_started = false;
    }
}

// Windows has no SIGPIPE; kept for API compatibility.
fn ignore_sigpipe() {
    return;
}


// ============================================================
// Internal
// ============================================================

fn net_make_sockaddr(ip: i64, port: u16): SockAddrIn {
    return SockAddrIn{
        family=cast(u16)AF_INET,
        port=htons(port),
        address=htonl(cast(u32)ip),
        zero=[8]byte{},
    };
}

// Winsock takes an i32 length.
fn net_clamp_len(n: i64): i32 {
    if n > 1073741824 {
        return 1073741824;
    }
    return cast(i32)n;
}

fn net_send_raw(s: TcpSocket, p: ^byte, count: i64): IoResult {
    if s.fd < 0 {
        return net_io_err(net_bad_socket());
    }
    while true {
        r := send(cast(u64)s.fd, p, net_clamp_len(count), 0);
        if r >= 0 {
            return net_io_ok(cast(i64)r);
        }
        err := net_fail();
        if err.kind != NET_ERR_INTERRUPTED {
            return net_io_err(err);
        }
    }
    return net_io_err(net_error(NET_ERR_OTHER, 0));
}


// ============================================================
// Client
// ============================================================

fn tcp_connect(host: string, port: u16): SockResult {
    init_err := net_init();
    if !net_ok(init_err) {
        return net_sock_err(init_err);
    }

    ip := net_host_to_ipv4(host);
    if ip < 0 {
        return net_sock_err(net_error(NET_ERR_BAD_ADDRESS, 0));
    }

    fd := cast(i64)socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if fd < 0 {
        return net_sock_err(net_fail());
    }

    _addr := net_make_sockaddr(ip, port);
    rc := connect(cast(u64)fd, cast(^byte)&_addr, 16);
    if rc < 0 {
        err := net_fail();
        closesocket(cast(u64)fd);
        return net_sock_err(err);
    }

    return net_sock_ok(TcpSocket{fd=fd});
}


// ============================================================
// Server
// ============================================================

fn tcp_listen(port: u16, backlog: i32): SockResult {
    init_err := net_init();
    if !net_ok(init_err) {
        return net_sock_err(init_err);
    }

    fd := cast(i64)socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if fd < 0 {
        return net_sock_err(net_fail());
    }

    // No SO_REUSEADDR: on Windows it lets other processes steal the port.
    _addr := net_make_sockaddr(0, port);    // 0.0.0.0
    rc := bind(cast(u64)fd, cast(^byte)&_addr, 16);
    if rc < 0 {
        err := net_fail();
        closesocket(cast(u64)fd);
        return net_sock_err(err);
    }

    rc = listen(cast(u64)fd, backlog);
    if rc < 0 {
        err := net_fail();
        closesocket(cast(u64)fd);
        return net_sock_err(err);
    }

    return net_sock_ok(TcpSocket{fd=fd});
}

fn tcp_accept(server: TcpSocket): SockResult {
    if server.fd < 0 {
        return net_sock_err(net_bad_socket());
    }
    while true {
        fd := cast(i64)accept(cast(u64)server.fd, 0, 0);
        if fd >= 0 {
            return net_sock_ok(TcpSocket{fd=fd});
        }
        err := net_fail();
        if err.kind != NET_ERR_INTERRUPTED {
            return net_sock_err(err);
        }
    }
    return net_sock_err(net_error(NET_ERR_OTHER, 0));
}


// ============================================================
// Sending / receiving
// ============================================================

// May send fewer bytes than asked (like send()).
fn tcp_send(s: TcpSocket, data: []byte): IoResult {
    n := len(data);
    if n == 0 {
        return net_io_ok(0);
    }
    return net_send_raw(s, &data[0], n);
}

// Sends everything or fails.
fn tcp_send_all(s: TcpSocket, data: []byte): NetError {
    n := len(data);
    sent: i64 = 0;
    while sent < n {
        r := net_send_raw(s, &data[sent], n - sent);
        if !net_ok(r.err) {
            return r.err;
        }
        if r.n == 0 {
            return net_error(NET_ERR_CLOSED, 0);
        }
        sent += r.n;
    }
    return net_no_error();
}

fn tcp_recv(s: TcpSocket, buffer: []byte): IoResult {
    if s.fd < 0 {
        return net_io_err(net_bad_socket());
    }
    n := len(buffer);
    if n == 0 {
        return net_io_err(net_error(NET_ERR_BAD_ARG, 0));
    }
    while true {
        r := recv(cast(u64)s.fd, &buffer[0], net_clamp_len(n), 0);
        if r >= 0 {
            return net_io_ok(cast(i64)r);
        }
        err := net_fail();
        if err.kind != NET_ERR_INTERRUPTED {
            return net_io_err(err);
        }
    }
    return net_io_err(net_error(NET_ERR_OTHER, 0));
}


// ============================================================
// Close / shutdown / options
// ============================================================

fn tcp_close(s: TcpSocket): NetError {
    if s.fd < 0 {
        return net_bad_socket();
    }
    rc := closesocket(cast(u64)s.fd);
    if rc != 0 {
        return net_fail();
    }
    return net_no_error();
}

fn tcp_shutdown(s: TcpSocket, how: i32): NetError {
    if s.fd < 0 {
        return net_bad_socket();
    }
    rc := shutdown(cast(u64)s.fd, how);
    if rc != 0 {
        return net_fail();
    }
    return net_no_error();
}

// Windows SO_RCVTIMEO is a DWORD in milliseconds. Zero = block forever.
fn tcp_set_recv_timeout(s: TcpSocket, seconds: i64, microseconds: i64): NetError {
    if s.fd < 0 {
        return net_bad_socket();
    }
    timeout_ms: u32 = cast(u32)(seconds * 1000 + microseconds / 1000);
    rc := setsockopt(cast(u64)s.fd, SOL_SOCKET, SO_RCVTIMEO, cast(^byte)&timeout_ms, 4);
    if rc != 0 {
        return net_fail();
    }
    return net_no_error();
}
