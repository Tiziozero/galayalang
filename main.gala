 import "core/core_windows.gala";
extern fn printf(fmt: ^byte, data: ..any): i32;

fn cstr(s: string): ^byte {
    return &s[0]
}
fn test_any::<$T>(a: any, s: string) {
    printf(cstr("ty id : %d, expected %d for %s\n"), a.type, type_id(T),  cstr(s));
}

fn t::<$T>(s: string) {
    test_any::<T>(cast(T)1, s)
}

fn main(): i32 {
    t::<int>("int")
    t::<i64>("i64")
    t::<i32>("i32")
    t::<f64>("f64")
    t::<f32>("f32")
    t::<byte>("byte")
}
