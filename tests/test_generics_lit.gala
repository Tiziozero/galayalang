import "core/core.gala";

// Function literals and generics. Passes iff there are no FAIL lines and it prints "all passed".

fn check(name: string, ok: bool) {
    if !ok {
        println("FAIL:", name);
    }
}

fn id(a: $T): T { return a; }

// a literal inside a generic body is cloned and re-resolved per version
fn with_lit(a: $T): T {
    g := fn(x: i64): i64 => x + 1;
    check("lit in generic", g(1) == 2);
    return a;
}

// generic called from a literal inside a generic body
fn lit_calls_generic(a: $T): i64 {
    g := fn(x: i64): i64 => id(x);
    return g(5);
}

fn main() {
    check("with_lit i64", with_lit(1) == 1);
    check("with_lit f64", with_lit(1.5) == 1.5);
    h := fn(x: i32): i32 => id(x);
    check("generic inside literal", h(3) == 3);
    check("lit_calls_generic byte", lit_calls_generic(cast(byte)1) == 5);
    check("lit_calls_generic f64", lit_calls_generic(2.0) == 5);
    println("all passed");
}
