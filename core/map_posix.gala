// map.gala
//
// Hash map: open addressing, linear probing, power-of-two capacity.
// No traits, so hashing and equality are function values stored in the map:
//   m := map_make::<string, i64>(0, hash_str, eq_str);   // Map(string, i64)
// K and V are given explicitly with ::<K, V> on map_make; every other
// function infers them from the map argument.
// Slot states live in a separate byte array; deleted slots are tombstones.

import "./core_posix.gala";
import "./mem_posix.gala";

SLOT_EMPTY: byte = 0;
SLOT_FULL: byte = 1;
SLOT_DELETED: byte = 2;

struct Map {
    keys: []$K,
    vals: []$V,
    state: []byte,
    count: i64,      // live entries
    used: i64,       // live + tombstones, drives the load factor
    hash: fn(hash_key: K): u64,
    eq: fn(eq_a: K, eq_b: K): bool,
    allocator: Allocator,
}

// ---------------------------------------------------------------- hashing

fn hash_i64(k: i64): u64 {
    x := cast(u64)k * 0x2545F4914F6CDD1D;
    return x + (x >> 32);
}

fn eq_i64(a: i64, b: i64): bool { return a == b; }

fn hash_i32(k: i32): u64 { return hash_i64(cast(i64)k); }
fn eq_i32(a: i32, b: i32): bool { return a == b; }

// djb2
fn hash_str(s: string): u64 {
    h : u64 = 5381;
    i := 0;
    while i < len(s) {
        h = h * 33 + cast(u64)s[i];
        i += 1;
    }
    return h;
}

fn eq_str(a: string, b: string): bool {
    n := len(a);
    if n != len(b) { return false; }
    if n == 0 { return true; }
    return mem_equal(transmute(rawptr)&a[0], transmute(rawptr)&b[0], cast(u64)n);
}

// ---------------------------------------------------------------- internals

// Inserts without growing. The table must have at least one empty slot.
fn map_insert_nogrow(m: ^Map($K, $V), k: K, v: V) {
    h := m^.hash;
    eq := m^.eq;
    mask := len(m^.state) - 1;
    i := cast(i64)(h(k) & cast(u64)mask);
    tomb := -1;
    while true {
        st := m^.state[i];
        if st == SLOT_EMPTY {
            if tomb >= 0 {
                i = tomb;
            } else {
                m^.used += 1;
            }
            m^.keys[i] = k;
            m^.vals[i] = v;
            m^.state[i] = SLOT_FULL;
            m^.count += 1;
            return;
        }
        if st == SLOT_DELETED {
            if tomb < 0 { tomb = i; }
        } else if eq(m^.keys[i], k) {
            m^.vals[i] = v;
            return;
        }
        i = (i + 1) & mask;
    }
}

// Rebuilds the table with new_cap slots (a power of two), dropping tombstones.
// On allocation failure returns false and leaves the map untouched.
fn map_resize(m: ^Map($K, $V), new_cap: i64): bool {
    nk := make_slice::<K>(new_cap, m^.allocator);
    nv := make_slice::<V>(new_cap, m^.allocator);
    ns := make_slice::<byte>(new_cap, m^.allocator);
    if len(nk) == 0 || len(nv) == 0 || len(ns) == 0 {
        del_slice(nk, m^.allocator);
        del_slice(nv, m^.allocator);
        del_slice(ns, m^.allocator);
        return false;
    }
    fresh := Map(K, V){nk, nv, ns, 0, 0, m^.hash, m^.eq, m^.allocator};
    i := 0;
    while i < len(m^.state) {
        if m^.state[i] == SLOT_FULL {
            map_insert_nogrow(&fresh, m^.keys[i], m^.vals[i]);
        }
        i += 1;
    }
    del_slice(m^.keys, m^.allocator);
    del_slice(m^.vals, m^.allocator);
    del_slice(m^.state, m^.allocator);
    m^ = fresh;
    return true;
}

// Slot index of k, or -1.
fn map_find(m: ^Map($K, $V), k: K): i64 {
    cap := len(m^.state);
    if cap == 0 { return -1; }
    h := m^.hash;
    eq := m^.eq;
    mask := cap - 1;
    i := cast(i64)(h(k) & cast(u64)mask);
    probes := 0;
    while probes < cap {
        st := m^.state[i];
        if st == SLOT_EMPTY { return -1; }
        if st == SLOT_FULL && eq(m^.keys[i], k) { return i; }
        i = (i + 1) & mask;
        probes += 1;
    }
    return -1;
}

// ---------------------------------------------------------------- public API

fn map_make::<$K, $V>(cap: i64, hash: fn(hk: K): u64, eq: fn(ea: K, eb: K): bool, a: Allocator = base_allocator): Map(K, V) {
    m := Map(K, V){make_slice::<K>(0, a), make_slice::<V>(0, a), make_slice::<byte>(0, a), 0, 0, hash, eq, a};
    if cap > 0 { map_reserve(&m, cap); }
    return m;
}

// Room for n entries without further growth.
fn map_reserve(m: ^Map($K, $V), n: i64): bool {
    need := n * 4 / 3 + 1;
    if len(m^.state) >= need { return true; }
    c := 8;
    while c < need { c *= 2; }
    return map_resize(m, c);
}

// Inserts or overwrites. False on allocation failure.
fn map_put(m: ^Map($K, $V), k: K, v: V): bool {
    cap := len(m^.state);
    if (m^.used + 1) * 4 > cap * 3 {
        new_cap := cap;
        if (m^.count + 1) * 2 > cap { new_cap = cap * 2; }
        if new_cap < 8 { new_cap = 8; }
        if !map_resize(m, new_cap) { return false; }
    }
    map_insert_nogrow(m, k, v);
    return true;
}

fn map_has(m: ^Map($K, $V), k: K): bool { return map_find(m, k) >= 0; }

// Pointer to the stored value (valid until the next put), or 0 if missing.
fn map_get_ptr(m: ^Map($K, $V), k: K): ^V {
    i := map_find(m, k);
    if i < 0 { return transmute(^V)NULL; }
    return &m^.vals[i];
}

// Copies the value into `out` if found.
fn map_get(m: ^Map($K, $V), k: K, out: ^V): bool {
    i := map_find(m, k);
    if i < 0 { return false; }
    out^ = m^.vals[i];
    return true;
}
fn map_get_m(m: Map($K, $V), k: K, out: ^V): bool {
    _m := m;
    i := map_find(&_m, k);
    if i < 0 { return false; }
    out^ = m.vals[i];
    return true;
}

fn map_remove(m: ^Map($K, $V), k: K): bool {
    i := map_find(m, k);
    if i < 0 { return false; }
    m^.state[i] = SLOT_DELETED;
    m^.count -= 1;
    return true;
}

fn map_clear(m: ^Map($K, $V)) {
    i := 0;
    while i < len(m^.state) {
        m^.state[i] = SLOT_EMPTY;
        i += 1;
    }
    m^.count = 0;
    m^.used = 0;
}

fn map_free(m: ^Map($K, $V)) {
    del_slice(m^.keys, m^.allocator);
    del_slice(m^.vals, m^.allocator);
    del_slice(m^.state, m^.allocator);
    m^.count = 0;
    m^.used = 0;
    empty := RawSlice{transmute(^byte)NULL, 0};
    m^.keys = transmute([]K)empty;
    m^.vals = transmute([]V)empty;
    m^.state = transmute([]byte)empty;
}

// Iteration: walk slots 0..map_slots(&m) and use the full ones.
//   i := 0;
//   while i < map_slots(&m) {
//       if map_slot_full(&m, i) { use(m.keys[i], m.vals[i]); }
//       i += 1;
//   }
fn map_slots(m: ^Map($K, $V)): i64 { return len(m^.state); }
fn map_slot_full(m: ^Map($K, $V), i: i64): bool { return m^.state[i] == SLOT_FULL; }
