import "core/core.gala";
import "tests/generics_lib.gala";

// Helper module for test_generics_import.gala. Imports generics_lib, so the
// test file importing both makes a diamond: core <- lib <- lib2 and core <- lib.

fn lib2_add3(a: $T, b: T, c: T): T { return lib_add(lib_add(a, b), c); }

fn lib2_swap_sum(a: ^$T, b: ^T): T {
    lib_swap(a, b);
    return a^ + b^;
}

// same instantiation as lib_nongeneric_i64() and as the importer's own lib_add(1, 2)
fn lib2_nongeneric(): i64 { return lib_add(1, 2); }

// generic from lib2 that uses lib's struct + counter through a lib generic
fn lib2_counted_pair(a: $T, b: T): LibPair {
    lib_bump();
    return lib_make_pair(a, b);
}

// thin wrapper that forwards the same T to a lib generic
fn lib2_double(a: $T): T { return lib_add(a, a); }
