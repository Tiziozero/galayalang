extern fn SetWindowSize(width: i32, height: i32);
extern fn SetWindowMinSize(width: i32, height: i32);

extern fn GetScreenWidth(): i32;
extern fn GetScreenHeight(): i32;
extern fn GetRenderWidth(): i32;
extern fn GetRenderHeight(): i32;

extern fn ShowCursor();
extern fn HideCursor();
extern fn EnableCursor();
extern fn DisableCursor();


