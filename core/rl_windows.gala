// ============================================================
// Collision
// ============================================================

extern fn CheckCollisionRecs(rec1: Rectangle, rec2: Rectangle): bool;
extern fn CheckCollisionCircles(center1: Vector2, radius1: f32, center2: Vector2, radius2: f32): bool;
