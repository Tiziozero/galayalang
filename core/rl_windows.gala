extern fn GetRayCollisionMesh(ray: Ray, mesh: Mesh, transform: Matrix): RayCollision;


// ============================================================
// Shaders
// ============================================================

extern fn LoadShader(vsFileName: ^byte, fsFileName: ^byte): Shader;   // pass 0 for the default vs/fs
extern fn LoadShaderFromMemory(vsCode: ^byte, fsCode: ^byte): Shader;
