import "core/core.gala";
import "tests/generics_lib.gala";
import "tests/generics_lib2.gala";
import "tests/generics_lib_bad.gala";

// Generics across modules. Needs generics_lib.gala, generics_lib2.gala and generics_lib_bad.gala next to it.
// Passes iff there are no FAIL lines and it prints "all passed".
// Adjust the import paths if your resolver wants them relative to this file.

fn check(name: string, ok: bool) {
    if !ok {
        println("FAIL:", name);
    }
}

struct LocalPair { a, b: i64 }
struct LocalV2 { x, y: f32 }
struct LocalIntXY { x, y: i64 }

// a generic declared here that forwards to a generic from another module
fn local_wrap(a: $T): T { return lib_id(a); }
fn local_add3(a: $T, b: T, c: T): T { return lib_add(lib_add(a, b), c); }
fn local_swap_wrap(a: ^$T, b: ^T) { lib_swap(a, b); }

// local generic with the same instantiation as lib's own use
fn local_i32_sum(): i32 { return lib_add(cast(i32)20, cast(i32)22); }

fn main() {
    // ---- basic: every instantiation made from another module
    check("lib_id i64", lib_id(41) == 41);
    check("lib_id i32", lib_id(cast(i32)7) == cast(i32)7);
    check("lib_id f64", lib_id(2.5) == 2.5);
    check("lib_id bool", lib_id(true) == true);
    check("lib_id string", len(lib_id("hello")) == 5);
    check("lib_id lib struct", lib_id(LibPair{1, 2}).b == 2);
    check("lib_id local struct", lib_id(LocalPair{3, 4}).a == 3);
    check("lib_add i64", lib_add(1, 2) == 3);
    check("lib_add i32", lib_add(cast(i32)1, cast(i32)2) == cast(i32)3);
    check("lib_add f64", lib_add(1.5, 2.25) == 3.75);
    check("lib_add byte wrap", lib_add(cast(byte)200, cast(byte)100) == cast(byte)44);
    check("lib_size", lib_size(cast(i32)1) == 4 && lib_size(1) == 8 && lib_size(LibPair{1, 2}) == 16);
    check("lib_size local struct", lib_size(LocalV2{1.0, 2.0}) == 8);

    // ---- pointers / slices / fn params
    s1 := 1;
    s2 := 2;
    lib_swap(&s1, &s2);
    check("lib_swap i64", s1 == 2 && s2 == 1);
    lp1 := LibPair{1, 2};
    lp2 := LibPair{3, 4};
    lib_swap(&lp1, &lp2);
    check("lib_swap lib struct", lp1.a == 3 && lp2.a == 1);
    lq1 := LocalPair{1, 2};
    lq2 := LocalPair{3, 4};
    lib_swap(&lq1, &lq2);
    check("lib_swap local struct", lq1.a == 3 && lq2.b == 2);
    ints := [4]i64{1, 2, 3, 4};
    f32s := [3]f32{1.5, 2.5, 3.0};
    check("lib_sum i64", lib_sum(ints[:]) == 10);
    check("lib_sum f32", lib_sum(f32s[:]) == 7.0);
    check("lib_apply lambda defined here", lib_apply(5, fn(x: i64): i64 => x * 2) == 10);
    check("lib_apply f64", lib_apply(1.5, fn(x: f64): f64 => x + 1.0) == 2.5);

    // ---- generic -> generic inside the lib, generic -> lib-private helper
    check("lib_add_twice", lib_add_twice(1, 2) == 5);
    check("lib_add_twice f64", lib_add_twice(0.5, 0.25) == 1.0);
    check("lib_uses_helper i64", lib_uses_helper(5) == 1005);
    check("lib_uses_helper i32", lib_uses_helper(cast(i32)6) == 1006);
    check("lib_uses_helper f64", lib_uses_helper(7.9) == 1007);

    // ---- one module global, shared by every instantiation and every module
    check("counter starts 0", lib_count() == 0);
    lib_counted(1);
    lib_counted(2.5);
    lib_counted(cast(i32)3);
    check("counter shared across instantiations", lib_count() == 3);
    lib_counted(1);
    check("counter same instantiation again", lib_count() == 4);

    // ---- types declared in the lib show up in generic bodies
    check("lib_make_pair i32", lib_make_pair(cast(i32)1, cast(i32)2).b == 2);
    check("lib_make_pair f64", lib_make_pair(1.9, 2.9).a == 1);

    // ---- defaults / variadics / duck typing through the module boundary
    check("lib_pad default", lib_pad(1) == 6);
    check("lib_pad explicit", lib_pad(1, 10) == 11);
    check("lib_pad f64", lib_pad(2.5) == 7);
    check("lib_vsum", lib_vsum(1, 2, 3) == 6);
    check("lib_vsum f64", lib_vsum(1.5, 2.5) == 4.0);
    check("lib_dot lib struct x lib struct", lib_dot(LibV2{1.0, 2.0}, LibV2{3.0, 4.0}) == 11.0);
    check("lib_dot local x local", lib_dot(LocalV2{1.0, 2.0}, LocalV2{3.0, 4.0}) == 11.0);
    check("lib_dot lib x local", lib_dot(LibV2{1.0, 2.0}, LocalV2{3.0, 4.0}) == 11.0);

    // ---- same instantiation requested from several modules: no duplicate symbol, same result
    check("lib_add(1,2) here", lib_add(1, 2) == 3);
    check("lib_add(1,2) in lib", lib_nongeneric_i64() == 3);
    check("lib_add(1,2) in lib2", lib2_nongeneric() == 3);
    check("lib_add i32 here", lib_add(cast(i32)20, cast(i32)22) == cast(i32)42);
    check("lib_add i32 in lib", lib_nongeneric_calls_generic() == cast(i32)42);
    check("lib_add i32 in this module's fn", local_i32_sum() == cast(i32)42);

    // ---- diamond: lib2 -> lib, test -> lib, test -> lib2
    check("lib2_add3", lib2_add3(1, 2, 3) == 6);
    check("lib2_add3 f64", lib2_add3(0.5, 0.25, 0.25) == 1.0);
    check("lib2_add3 i32", lib2_add3(cast(i32)1, cast(i32)2, cast(i32)3) == cast(i32)6);
    check("lib2_double", lib2_double(21) == 42);
    check("lib2_double f64", lib2_double(1.25) == 2.5);
    d1 := 1;
    d2 := 2;
    check("lib2_swap_sum", lib2_swap_sum(&d1, &d2) == 3);
    check("lib2_swap_sum swapped", d1 == 2 && d2 == 1);
    before := lib_count();
    cp := lib2_counted_pair(cast(i32)5, cast(i32)6);
    check("lib2_counted_pair value", cp.a == 5 && cp.b == 6);
    check("lib2_counted_pair counter (lib global from lib2)", lib_count() == before + 1);

    // ---- local generics forwarding to imported ones
    check("local_wrap", local_wrap(5) == 5);
    check("local_wrap struct", local_wrap(LocalPair{1, 2}).b == 2);
    check("local_add3", local_add3(1, 2, 3) == 6);
    check("local_add3 f64", local_add3(0.5, 0.25, 0.25) == 1.0);
    w1 := LocalIntXY{1, 2};
    w2 := LocalIntXY{3, 4};
    local_swap_wrap(&w1, &w2);
    check("local_swap_wrap", w1.x == 3 && w2.y == 2);

    // ---- type ids are the same no matter which module asks
    check("type_id i64 through lib", lib_type_tag(1) == type_id(i64));
    check("type_id f64 through lib", lib_type_tag(1.0) == type_id(f64));
    check("type_id i32 through lib", lib_type_tag(cast(i32)1) == type_id(i32));
    check("type_id distinct structs", lib_type_tag(LibPair{1, 2}) != lib_type_tag(LocalPair{1, 2}));

    // ---- generics from a module whose other generic is broken
    check("uninstantiated broken generic is fine", lib_bad_unused_ok(5) == 5);

    // ---- calls in odd places
    total := 0;
    k := 0;
    while k < 100 {
        total = total + lib_id(k);
        k = k + 1;
    }
    check("lib generic in while", total == 4950);
    check("lib generic as index", ints[lib_id(2)] == 3);
    check("lib generic nested", lib_id(lib_id(lib_add(lib_id(1), lib_id(2)))) == 3);

    println("all passed");
}
