KEY_F8            : i32 = 297;
KEY_F9            : i32 = 298;
KEY_F10           : i32 = 299;
KEY_F11           : i32 = 300;
KEY_F12           : i32 = 301;

KEY_LEFT_SHIFT    : i32 = 340;
