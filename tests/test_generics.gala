import "core/core.gala";
import "core/mem.gala";
import "core/dynarray.gala";
import "core/map.gala";

// Passes iff there are no FAIL lines and it prints "all passed".

fn check(name: string, ok: bool) {
    if !ok {
        println("FAIL:", name);
    }
}

struct Pair { a: i32, b: i32 }

fn size_of_t(a: $T): i64 { return size_of(T); }

fn main() {
    // ---------------------------------------------------------------- DynArray
    da := dyn_make::<i64>(0);
    check("empty", da.length == 0 && dyn_cap(&da) == 0);
    i := 0;
    while i < 100 {
        dyn_push(&da, i * 2);
        i += 1;
    }
    check("length", da.length == 100);
    check("capacity doubles", dyn_cap(&da) == 128);
    check("get", dyn_get(&da, 0) == 0 && dyn_get(&da, 50) == 100 && dyn_last(&da) == 198);
    check("pop", dyn_pop(&da) == 198 && da.length == 99);
    dyn_set(&da, 0, 7);
    check("set", dyn_get(&da, 0) == 7);
    check("slice len", len(dyn_slice(&da)) == 99);

    da_small := dyn_make::<i64>( 0);
    dyn_push(&da_small, 1);
    dyn_push(&da_small, 2);
    dyn_push(&da_small, 3);
    check("insert middle", dyn_insert(&da_small, 1, 10) && dyn_get(&da_small, 1) == 10 && dyn_get(&da_small, 2) == 2);
    check("insert end", dyn_insert(&da_small, 4, 99) && dyn_last(&da_small) == 99);
    check("insert front", dyn_insert(&da_small, 0, 5) && dyn_get(&da_small, 0) == 5 && dyn_get(&da_small, 1) == 1);
    check("length after inserts", da_small.length == 6);
    check("remove keeps order", dyn_remove(&da_small, 1) == 1 && dyn_get(&da_small, 1) == 10);
    check("swap_remove", dyn_swap_remove(&da_small, 0) == 5 && dyn_get(&da_small, 0) == 99);
    check("length after removes", da_small.length == 4);
    dyn_clear(&da_small);
    check("clear keeps capacity", da_small.length == 0 && dyn_cap(&da_small) > 0);

    extra := [3]i64{4, 5, 6};
    check("extend", dyn_extend(&da_small, extra[:]) && da_small.length == 3 && dyn_get(&da_small, 2) == 6);

    da_i32 := dyn_make::<i32>(0);
    dyn_push(&da_i32, 5);
    check("i32 literal adapts", size_of_t(dyn_get(&da_i32, 0)) == 4);

    da_pair := dyn_make::<Pair>(2);
    dyn_push(&da_pair, Pair{1, 2});
    dyn_push(&da_pair, Pair{3, 4});
    dyn_push(&da_pair, Pair{5, 6});
    check("struct elements survive growth", dyn_get(&da_pair, 0).b == 2 && dyn_get(&da_pair, 2).a == 5);

    // custom allocator
    arena := arena_make(1 * MB);
    arena_a := arena_allocator(&arena);
    da_arena := dyn_make::<i64>(0, arena_a);
    j := 0;
    while j < 1000 {
        dyn_push(&da_arena, j);
        j += 1;
    }
    check("arena backed", da_arena.length == 1000 && dyn_get(&da_arena, 999) == 999 && arena_used(&arena) > 0);
    arena_destroy(&arena);

    dyn_free(&da);
    check("free", da.length == 0 && dyn_cap(&da) == 0);
    dyn_push(&da, 1);
    check("push after free", da.length == 1 && dyn_get(&da, 0) == 1);

    // ---------------------------------------------------------------- Map
    m := map_make::<i64, i64>(0, hash_i64, eq_i64);
    check("map empty", m.count == 0 && !map_has(&m, 1));
    k := 0;
    while k < 1000 {
        map_put(&m, k, k * 3);
        k += 1;
    }
    check("map count", m.count == 1000);
    check("map has", map_has(&m, 0) && map_has(&m, 999) && !map_has(&m, 1000));
    got := 0;
    check("map get", map_get(&m, 500, &got) && got == 1500);
    check("map get missing", !map_get(&m, -5, &got) && got == 1500);

    map_put(&m, 500, 1);
    check("overwrite", m.count == 1000 && map_get_ptr(&m, 500)^ == 1);
    p := map_get_ptr(&m, 7);
    p^ += 100;
    check("get_ptr write", map_get_ptr(&m, 7)^ == 121);
    check("get_ptr missing", map_get_ptr(&m, 5000) == 0);

    removed := 0;
    r := 0;
    while r < 1000 {
        if r % 2 == 0 && map_remove(&m, r) { removed += 1; }
        r += 1;
    }
    check("remove count", removed == 500 && m.count == 500);
    check("removed gone", !map_has(&m, 10) && map_has(&m, 11));
    check("remove missing", !map_remove(&m, 10));

    // tombstones are reused and don't break probing
    t := 0;
    while t < 1000 {
        map_put(&m, t, t);
        t += 1;
    }
    check("reinsert", m.count == 1000 && map_get_ptr(&m, 10)^ == 10 && map_get_ptr(&m, 11)^ == 11);

    // churn: insert and remove repeatedly, table must not fill with tombstones
    c := 0;
    while c < 5000 {
        map_put(&m, 100000 + c, c);
        map_remove(&m, 100000 + c);
        c += 1;
    }
    check("churn", m.count == 1000 && map_has(&m, 999));

    // iteration
    key_sum := 0;
    s := 0;
    while s < map_slots(&m) {
        if map_slot_full(&m, s) { key_sum += m.keys[s]; }
        s += 1;
    }
    check("iterate", key_sum == 499500);

    map_clear(&m);
    check("clear", m.count == 0 && !map_has(&m, 3));
    map_put(&m, 3, 4);
    check("put after clear", map_get_ptr(&m, 3)^ == 4);
    map_free(&m);
    check("free", m.count == 0 && map_slots(&m) == 0 && !map_has(&m, 3));

    m_res := map_make::<i64, i64>(100, hash_i64, eq_i64);
    check("reserve", map_slots(&m_res) >= 134 && m_res.count == 0);

    // string keys
    ms := map_make::<string, i64>(0, hash_str, eq_str);
    map_put(&ms, "one", 1);
    map_put(&ms, "two", 2);
    map_put(&ms, "three", 3);
    map_put(&ms, "", 0);
    check("string keys", map_get_ptr(&ms, "two")^ == 2 && map_get_ptr(&ms, "three")^ == 3);
    check("empty string key", map_has(&ms, ""));
    check("string miss", !map_has(&ms, "four") && !map_has(&ms, "tw"));
    map_put(&ms, "one", 11);
    check("string overwrite", map_get_ptr(&ms, "one")^ == 11 && ms.count == 4);

    // other value and key types
    m32 := map_make::<i32, f64>(0, hash_i32, eq_i32);
    map_put(&m32, 4, 1.5);
    map_put(&m32, 5, 2.5);
    check("i32 -> f64", map_get_ptr(&m32, 4)^ == 1.5 && map_get_ptr(&m32, 5)^ == 2.5);

    mp := map_make::< i64, Pair>(0, hash_i64, eq_i64);
    map_put(&mp, 1, Pair{7, 8});
    check("struct values", map_get_ptr(&mp, 1)^.b == 8);

    // arena backed map
    arena_m := arena_make(4 * MB);
    ma := map_make::<i64, i64>(0, hash_i64, eq_i64, arena_allocator(&arena_m));
    q := 0;
    while q < 300 {
        map_put(&ma, q, q);
        q += 1;
    }
    check("arena map", ma.count == 300 && map_get_ptr(&ma, 299)^ == 299);
    arena_destroy(&arena_m);

    println("all passed");
}
