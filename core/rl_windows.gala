// rl.gala
import "./core_windows.gala";

// @link("./libraylib.so.600")

@link("/DEFAULTLIB:opengl32.lib")
@link("/DEFAULTLIB:gdi32.lib")
@link("/DEFAULTLIB:winmm.lib")
@link("/DEFAULTLIB:user32.lib")
@link("/DEFAULTLIB:shell32.lib")

// ============================================================
// Types
// ============================================================

struct Vector2 {
    x: f32,
    y: f32,
}

struct Vector3 {
    x: f32,
    y: f32,
    z: f32,
}

struct Vector4 {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
}
alias Quaternion = Vector4;

struct Color {
    r: byte,
    g: byte,
    b: byte,
    a: byte,
}

struct Rectangle {
    x: f32,
    y: f32,
    w: f32,
    h: f32,
}

// 4x4 matrix, 16 floats in raylib's order (m0, m4, m8, m12, m1, ...)
struct Matrix {
    data: [16]f32,
}

struct Texture {
    id: u32,
    width: i32,
    height: i32,
    mipmaps: i32,
    format: i32,
}
alias Texture2D = Texture;

struct RenderTexture {
    id: u32,
    texture: Texture,
    depth: Texture,
}
alias RenderTexture2D = RenderTexture;

struct Image {
    data: ^void,
    width: i32,
    height: i32,
    mipmaps: i32,
    format: i32,
}

struct GlyphInfo {
    value: i32,
    offsetX: i32,
    offsetY: i32,
    advanceX: i32,
    image: Image,
}

struct Font {
    baseSize: i32,
    glyphCount: i32,
    glyphPadding: i32,
    texture: Texture,
    recs: ^Rectangle,
    glyphs: ^GlyphInfo,
}

struct Camera2D {
    offset: Vector2,
    target: Vector2,
    rotation: f32,
    zoom: f32,
}

struct Camera {
    position: Vector3,
    target: Vector3,
    up: Vector3,
    fovy: f32,
    projection: i32,
}
alias Camera3D = Camera;

struct Ray {
    position: Vector3,
    direction: Vector3,
}

struct RayCollision {
    hit: bool,
    distance: f32,
    point: Vector3,
    normal: Vector3,
}

struct BoundingBox {
    min, max: Vector3,
}

// ---- models / meshes / materials ----

struct Transform {
    translation: Vector3,
    rotation: Quaternion,
    scale: Vector3,
}
alias ModelAnimPose = ^Transform;

struct BoneInfo {
    name: [32]byte,
    parent: i32,
}

struct ModelSkeleton {
    boneCount: u32,
    bones: ^BoneInfo,
    bindPose: ModelAnimPose,
}

struct Mesh {
    vertexCount: i32,
    triangleCount: i32,

    vertices: ^f32,
    texcoords: ^f32,
    texcoords2: ^f32,
    normals: ^f32,
    tangents: ^f32,
    colors: ^u8,
    indices: ^u16,

    boneCount: i32,
    boneIndices: ^u8,
    boneWeights: ^f32,

    animVertices: ^f32,
    animNormals: ^f32,

    vaoId: u32,
    vboId: ^u32,
}

struct Shader {
    id: u32,
    locs: ^i32,
}

struct MaterialMap {
    texture: Texture2D,
    color: Color,
    value: f32,
}

struct Material {
    shader: Shader,
    maps: ^MaterialMap,
    params: [4]f32,
}

struct Model {
    transform: Matrix,

    meshCount: i32,
    materialCount: i32,
    meshes: ^Mesh,
    materials: ^Material,
    meshMaterial: ^i32,

    skeleton: ModelSkeleton,
    currentPose: ModelAnimPose,
    boneMatrices: ^Matrix,
}

struct ModelAnimation {
    name: [32]byte,
    boneCount: u32,
    keyframeCount: i32,
    keyframePoses: rawptr,
}

// ---- audio ----

struct AudioStream {
    buffer: rawptr,
    processor: rawptr,
    sampleRate: u32,
    sampleSize: u32,
    channels: u32,
}

struct Sound {
    stream: AudioStream,
    frameCount: u32,
}

struct Music {
    stream: AudioStream,
    frameCount: u32,
    looping: bool,
    ctxType: i32,
    ctxData: rawptr,
}


// ============================================================
// Constants
// ============================================================

// ---- config flags (SetConfigFlags, call BEFORE InitWindow) ----
FLAG_VSYNC_HINT         :: 0x00000040;
FLAG_FULLSCREEN_MODE    :: 0x00000002;
FLAG_WINDOW_RESIZABLE   :: 0x00000004;
FLAG_WINDOW_UNDECORATED :: 0x00000008;
FLAG_WINDOW_HIDDEN      :: 0x00000080;
FLAG_WINDOW_ALWAYS_RUN  :: 0x00000100;
FLAG_MSAA_4X_HINT       :: 0x00000020;   // smooths geometry edges, big visual win for cheap
FLAG_INTERLACED_HINT    :: 0x00010000;

// ---- keys ----
KEY_NULL          : i32 = 0;
KEY_SPACE         : i32 = 32;
KEY_ESCAPE        : i32 = 256;
KEY_ENTER         : i32 = 257;
KEY_TAB           : i32 = 258;
KEY_BACKSPACE     : i32 = 259;
