extern fn UnloadShader(shader: Shader);

extern fn GetShaderLocation(shader: Shader, uniformName: ^byte): i32;
extern fn GetShaderLocationAttrib(shader: Shader, attribName: ^byte): i32;

extern fn SetShaderValue(shader: Shader, locIndex: i32, value: rawptr, uniformType: i32);
extern fn SetShaderValueV(shader: Shader, locIndex: i32, value: rawptr, uniformType: i32, count: i32);
extern fn SetShaderValueMatrix(shader: Shader, locIndex: i32, mat: Matrix);
extern fn SetShaderValueTexture(shader: Shader, locIndex: i32, texture: Texture);


// ============================================================
// rlgl (low level, needed for shadow maps and render state)
// ============================================================

// framebuffers
extern fn rlLoadFramebuffer(): u32;          // raylib 5.0 took (width, height)
