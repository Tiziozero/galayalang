import "core/core.gala";

// More generics tests: named args, untyped literal binding, nested type shapes,
// operators inside generic bodies. Passes iff there are no FAIL lines and it prints "all passed".
// Remember the no-shadowing rule: every local in main has a unique name.

fn check(name: string, ok: bool) {
    if !ok {
        println("FAIL:", name);
    }
}

fn id(a: $T): T { return a; }
fn add(a: $T, b: T): T { return a + b; }
fn sub(a: $T, b: T): T { return a - b; }
fn max2(a: $T, b: T): T {
    if a > b { return a; }
    return b;
}
fn size_of_t(a: $T): i64 { return size_of(T); }
fn apply(a: $T, f: fn(x: T): T): T { return f(a); }

// U is bound only through the return type of the function argument
// fn map1(a: $T, f: fn(x: T): $U): U { return f(a); }

fn arr_first(a: [3]$T): T { return a[0]; }
fn deref2(a: ^^$T): T { return a^^; }

fn vsum(data: ..$T): T {
    t : T = cast(T)0;
    for i in data { t += i; }
    return t;
}

fn shl(a: $T, b: T): T { return a << b; }
fn accum(a: $T, b: T): T {
    x : T = a;
    x += b;
    x <<= 1;
    return x;
}
fn both(a: $T, b: T): bool { return a && b; }
fn either(a: $T, b: T): bool { return a || b; }

fn main() {
    // ---- named args pick the param by name, not by position
    check("named sub swapped", sub(b=1, a=10) == 9);
    check("named add typed b", add(b=cast(i32)5, a=3) == cast(i32)8);
    check("positional then named", sub(10, b=4) == 6);

    // ---- untyped literals: typed / fn-bound args decide T, otherwise i64 / f64
    check("float literal first, int literal adapts", max2(2.5, 1) == 2.5);
    check("int literals are i64", size_of_t(add(1, 2)) == 8);
    check("float literals are f64", size_of_t(add(1.5, 2.5)) == 8);
    check("hex literal is i64", size_of_t(id(0xff)) == 8 && id(0xff) == 255);
    check("literal after typed i32", add(cast(i32)1, 2) == cast(i32)3);
    check("typed byte decides", size_of_t(add(cast(byte)1, 2)) == 1);
    check("fn binds T before literal", apply(5, fn(x: f64): f64 => x) == 5.0);
    check("fn binds T before literal f32", size_of_t(apply(1, fn(x: f32): f32 => x)) == 4);

    // ---- a generic that only appears in the fn argument's return type
    // check("U from fn return", map1(5, fn(x: i64): f64 => cast(f64)x * 0.5) == 2.5);
    // check("U is bool", map1(cast(i32)3, fn(x: i32): bool => x > 2));
    // check("U size", size_of_t(map1(1, fn(x: i64): byte => cast(byte)x)) == 1);

    // ---- nested type shapes
    a3 := [3]i32{4, 5, 6};
    f3 := [3]f32{1.5, 2.5, 3.5};
    check("fixed array i32", arr_first(a3) == 4);
    check("fixed array f32", arr_first(f3) == 1.5);

    d_val : i64 = 77;
    d_p := &d_val;
    d_pp := &d_p;
    check("pointer to pointer", deref2(d_pp) == 77);

    // ---- variadics: first typed arg decides, literals adapt
    check("vsum typed first", vsum(cast(i32)1, 2, 3) == cast(i32)6);
    check("vsum byte", vsum(cast(byte)100, 20, 30) == cast(byte)150);

    // ---- operators inside generic bodies
    check("shl i64", shl(1, 3) == 8);
    check("shl i32", shl(cast(i32)1, cast(i32)4) == cast(i32)16);
    check("shl byte", shl(cast(byte)1, cast(byte)7) == cast(byte)128);
    check("compound assign i64", accum(1, 2) == 6);
    check("compound assign i32", accum(cast(i32)2, cast(i32)3) == cast(i32)10);
    check("&& on bool", !both(true, false) && both(true, true));
    check("|| on bool", either(false, true) && !either(false, false));

    println("all passed");
}
