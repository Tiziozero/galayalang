KEY_RIGHT_SUPER   : i32 = 347;

KEY_ZERO  : i32 = 48;
KEY_ONE   : i32 = 49;
KEY_TWO   : i32 = 50;
KEY_THREE : i32 = 51;
KEY_FOUR  : i32 = 52;
KEY_FIVE  : i32 = 53;
KEY_SIX   : i32 = 54;
KEY_SEVEN : i32 = 55;
KEY_EIGHT : i32 = 56;
KEY_NINE  : i32 = 57;

KEY_A : i32 = 65;
KEY_B : i32 = 66;
KEY_C : i32 = 67;
KEY_D : i32 = 68;
KEY_E : i32 = 69;
KEY_F : i32 = 70;
KEY_G : i32 = 71;
KEY_H : i32 = 72;
KEY_I : i32 = 73;
KEY_J : i32 = 74;
KEY_K : i32 = 75;
KEY_L : i32 = 76;
