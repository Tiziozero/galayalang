import "core/core.gala";
import "core/mem.gala";
import "core/rl_posix.gala";

alias float = f64
alias State = struct {
    a: int, b: float
}
fn sin_tao(i: float): float {
    v := 2.0*PI

    return sin(v*i)
}
WIDTH   :: 800
HEIGHT  :: 800
project := fn(x, y: f32): Vector2 => { x + WIDTH/2, -y + HEIGHT/2 } 
point   := fn(x, y: f32) { DrawCircleV(project(x, y), 2, {255,255,255,255})}
line    := fn(x1, y1, x2, y2: f32) {
    DrawLineV(project(x1, y1), project(x2, y2), {255,255,255,255})
}
circle  := fn(x, y, r: f32) {
     DrawCircleLinesV(project(x, y), r, {255, 255, 255, 255})
}
fn map(data: []$T, f: fn(i: T): T) {
    i := 0
    while i < len(data) {
        data[i] = f(data[i])
        i += 1
    }
}
draw    := fn(f: fn(i: f32): f32, x1, x2: f32) {
    if x1 > x2 { return }
    x := x1
    px := x
    py := f(x)
    x += 1
    while x <= x2 {
        y := f(x)
        line(px, py, x, y)
        px = x
        py = y
        x += 1
    }
}
fn draw_t(f: fn(i, t: f32): f32, x1, x2, t: f32) {
    if x1 > x2 { return }
    x := x1
    px := x
    py := f(x, t)
    x += 1
    while x <= x2 {
        y := f(x, t)
        line(px, py, x, y)
        px = x
        py = y
        x += 1
    }
}
//x1, x2: limits
fn draw_any(f: fn(i: f32, data:[]any): f32, x1, x2: f32, _data:..any) {
    if x1 > x2 { return }
    x := x1
    px := x
    py := f(x, _data)
    x += 1
    while x <= x2 {
        y := f(x, _data)
        line(px, py, x, y)
        px = x
        py = y
        x += 1
    }
}
fn eclipse(x, y, a, b: f32) {
    f := fn(i: f32, data: []any): f32 {
        _x := any_as::<f32>(data[0])^
        _y := any_as::<f32>(data[1])^
        _a := any_as::<f32>(data[2])^
        _b := any_as::<f32>(data[3])^
        ny := _b/_a*sqrtf(-powf(i-_x, 2) + powf(_a, 2))
        return _y+ny
    }
    g := fn(i: f32, data: []any): f32 {
        _x := any_as::<f32>(data[0])^
        _y := any_as::<f32>(data[1])^
        _a := any_as::<f32>(data[2])^
        _b := any_as::<f32>(data[3])^
        ny := -_b/_a*sqrtf(-powf(i-_x, 2) + powf(_a, 2))
        return _y+ny
    }
    draw_any(f, x-a, x+a, x, y, a, b)
    draw_any(g, x-a, x+a, x, y, a, b)
}
fn main(): i32 {
    a := arena_make(1024)
    s := new::<State>(arena_allocator(&a))
    sn := new::<State>(heap_allocator())
    println("Hello, World! {}", sin_tao(0));
    println("Hello, World! {}", sin_tao(1));
    println("Hello, World! {}", sin_tao(2));
    println("Hello, World! {}", sin_tao(2.25));
    InitWindow(800, 800, clone_cstring("Hello, Raylib!", arena_allocator(&a)), )
    SetTargetFPS(60)

    
    t: f32 = 0
    while !WindowShouldClose() {
        t += GetFrameTime()
        BeginDrawing()
        ClearBackground({10, 10, 10, 255})
        line(0, 300, 0, -300)
        line(300, 0, -300, 0)
        h : f32 = 100;
        theta : f32 = 0 + 2*PI/60* t
        adj := cosf(theta)*h
        opp := sinf(theta)*h
        // circle(0, 0, h)
        // line(0, 0, adj, opp)
        // draw(fn(i: f32): f32 => 40*sinf(i/50), -200, 200)
        // draw_t(fn(i, _t: f32): f32 => 40*sinf(_t + i/50), -200, 200, t)
        // draw_t(fn(i, _t: f32): f32 => 40*powf(sinf(_t + i/50), 2), -200, 200, t)
        // draw(fn(i: f32): f32 => powf(i/10, 2), -200, 200)

        point(-200, 50)
        point(200, 50)
        draw(fn(i: f32): f32 => powf(i/10, 2), -50, 50)
        draw(fn(i: f32): f32 {
            k := cast(f32)(cast(int)i % 50)
            if k >= 0 && k <= 20 { return 50 } 
            if k > 20 && k <= 50 { return 50 - 50*(k-20)/30 } 
            return 0
        }, -400, 400)
        eclipse(0, 50, 300, 100)
        DrawFPS(10, 10)
        EndDrawing()
    }
    CloseWindow()
    del(sn, heap_allocator())
    arena_destroy(&a)
    return 0
}
