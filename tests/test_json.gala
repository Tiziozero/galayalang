import "core/core.gala";
import "core/mem.gala";
import "core/map.gala";
import "core/json.gala";

// Passes iff there are no FAIL lines and it prints "all passed".

fn check(name: string, ok: bool) {
    if !ok {
        println("FAIL:", name);
    }
}

fn blank(): JsonValue {
    return JsonValue{0, "", 0.0, 0};
}

fn main() {
    arena := arena_make(1 * MB);
    a := arena_allocator(&arena);

    // ---------------------------------------------------------------- parse
    src := "{\"name\": \"gala\", \"version\": 1.5, \"nested\": {\"k\": \"v\"}, \"neg\": -2e2}";
    root := blank();
    check("parse ok", json_parse(src, &root, a));
    check("root is object", root.kind == JSON_OBJECT);

    name := blank();
    check("get name", json_get(root, "name", &name) && name.kind == JSON_STRING && eq_str(name.str, "gala"));
    ver := blank();
    check("get number", json_get(root, "version", &ver) && ver.kind == JSON_NUMBER && ver.num == 1.5);
    neg := blank();
    check("exponent", json_get(root, "neg", &neg) && neg.num == -200.0);
    nested := blank();
    check("nested object", json_get(root, "nested", &nested) && nested.kind == JSON_OBJECT);
    inner := blank();
    check("nested get", json_get(nested, "k", &inner) && eq_str(inner.str, "v"));
    missing := blank();
    check("missing key", !json_get(root, "nope", &missing));

    // escapes: \n, \" and \u0041 ('A')
    esc := blank();
    check("escapes parse", json_parse("\"a\\nb\\\"c\\u0041\"", &esc, a));
    check("escapes value", esc.kind == JSON_STRING && len(esc.str) == 6 && esc.str[1] == 10 && esc.str[3] == 34 && esc.str[5] == 65);

    empty := blank();
    check("empty object", json_parse("  {  }  ", &empty, a) && empty.kind == JSON_OBJECT);
    top_num := blank();
    check("top level number", json_parse("42", &top_num, a) && top_num.num == 42.0);

    // repeated key: last wins
    dup := blank();
    check("duplicate key", json_parse("{\"a\": 1, \"a\": 2}", &dup, a));
    dv := blank();
    check("duplicate key value", json_get(dup, "a", &dv) && dv.num == 2.0);

    // ---------------------------------------------------------------- errors
    bad := blank();
    check("unterminated object", !json_parse("{", &bad, a));
    check("missing value", !json_parse("{\"a\": }", &bad, a));
    check("trailing comma", !json_parse("{\"a\": 1,}", &bad, a));
    check("trailing data", !json_parse("{} x", &bad, a));
    check("bad number", !json_parse("-", &bad, a));
    check("unterminated string", !json_parse("\"abc", &bad, a));
    check("arrays unsupported", !json_parse("[1]", &bad, a));
    check("error message set", len(json_error) > 0);

    // ---------------------------------------------------------------- dump
    obj := json_object(a);
    check("set string", json_set(obj, "a", JsonValue{JSON_STRING, "b", 0.0, 0}));
    check("dump one key", eq_str(json_dump(obj, a), "{\"a\":\"b\"}"));
    check("dump empty", eq_str(json_dump(json_object(a), a), "{}"));
    check("dump number", eq_str(json_dump(JsonValue{JSON_NUMBER, "", 0.5, 0}, a), "0.5"));
    check("dump integer", eq_str(json_dump(JsonValue{JSON_NUMBER, "", 3.0, 0}, a), "3"));
    check("dump escapes", eq_str(json_dump(esc, a), "\"a\\nb\\\"cA\""));

    // round trip
    text := json_dump(root, a);
    again := blank();
    check("round trip parses", json_parse(text, &again, a));
    again_name := blank();
    check("round trip name", json_get(again, "name", &again_name) && eq_str(again_name.str, "gala"));
    again_nested := blank();
    check("round trip nested", json_get(again, "nested", &again_nested) && json_get(again_nested, "k", &inner));
    check("dump is stable", eq_str(json_dump(again, a), text));

    arena_destroy(&arena);

    // ---------------------------------------------------------------- heap + json_free
    heap_root := blank();
    check("heap parse", json_parse("{\"a\": \"x\", \"b\": {\"c\": \"y\"}}", &heap_root));
    json_free(heap_root);
    check("heap parse error cleans up", !json_parse("{\"a\": \"x\", \"b\": }", &heap_root));

    println("all passed");
}
