// test_functions.gala: function syntax.
// No shadowing anywhere: every name is unique within its scope chain.

import "core/core.gala";

failures := 0;

fn check(ok: bool, name: string) {
    if !ok {
        failures += 1;
        println("FAIL:", name);
    }
}

// ---------- plain functions ----------

fn add(a: i32, b: i32): i32 { return a + b; }
fn answer(): i32 { return 42; }
fn set_flag(p: ^bool) { p^ = true; }
fn early(p: ^i32, stop: bool) {
    if stop { return; }
    p^ = 1;
}
fn fact(n: i32): i32 {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}
// mutual recursion: declaration order must not matter
fn is_even(n: i32): bool {
    if n == 0 { return true; }
    return is_odd(n - 1);
}
fn is_odd(n: i32): bool {
    if n == 0 { return false; }
    return is_even(n - 1);
}
fn sum_slice(xs: []i32): i32 {
    total: i32 = 0;
    for v in xs { total += v; }
    return total;
}

fn test_basic() {
    check(add(2, 3) == 5, "add");
    check(answer() == 42, "no params");
    check(fact(5) == 120, "recursion");
    check(is_even(10), "mutual recursion even");
    check(!is_even(7), "mutual recursion odd");
    check(add(add(1, 2), add(3, 4)) == 10, "nested calls");
}

fn test_pointer_params() {
    flag: bool = false;
    set_flag(&flag);
    check(flag, "pointer param writes through");

    cell: i32 = 0;
    early(&cell, true);
    check(cell == 0, "bare return skips the rest");
    early(&cell, false);
    check(cell == 1, "falls through without return");
}

fn test_slice_params() {
    items := [3]i32{4, 5, 6};
    check(sum_slice(items[:]) == 15, "slice param");
    check(sum_slice(items[1:]) == 11, "sub-slice param");
}

// ---------- grouped params: `a, b: type` ----------

fn add3(a, b, c: i32): i32 { return a + b + c; }
fn mixed_group(label: string, x, y: i32, ok: bool): i32 {
    if ok { return x * y; }
    return 0;
}

fn test_grouped() {
    check(add3(1, 2, 3) == 6, "a, b, c: type");
    check(mixed_group("m", 3, 4, true) == 12, "group between other params");
    check(mixed_group("m", 3, 4, false) == 0, "param after a group");
}

// ---------- named args ----------

fn sub3(a, b, c: i32): i32 { return a - b - c; }

fn test_named_args() {
    check(sub3(10, 3, 1) == 6, "positional");
    check(sub3(c = 1, a = 10, b = 3) == 6, "all named, reordered");
    check(sub3(10, c = 1, b = 3) == 6, "positional then named");
    check(sub3(a = 10, b = 3, c = 1) == 6, "all named, in order");
}

// ---------- default values ----------

next_id: i32 = 0;
fn bump(): i32 {
    next_id += 1;
    return next_id;
}
fn pick(v: i32 = bump()): i32 { return v; }
fn scaled(base: i32, factor: i32 = 2, offset: i32 = 1): i32 {
    return base * factor + offset;
}
fn with_flag(x: i32, flag := true): bool { return flag; }
fn with_fn_default(v: i32, f: fn(l: i32): i32 = fn(l: i32): i32 => l + 1): i32 {
    return f(v);
}

fn test_defaults() {
    check(scaled(5) == 11, "both defaults");
    check(scaled(5, 3) == 16, "second default");
    check(scaled(5, 3, 4) == 19, "no defaults used");
    check(scaled(5, offset = 0) == 10, "skip a default by name");
    check(scaled(base = 1, offset = 5) == 7, "named base, named offset");

    check(with_flag(1), "inferred default (:=)");
    check(!with_flag(1, flag = false), "inferred default overridden");

    // a default is re-evaluated on every call that omits it
    check(pick() == 1, "default thunk first call");
    check(pick() == 2, "default thunk re-evaluated");
    check(pick(10) == 10, "explicit arg skips the thunk");
    check(pick() == 3, "thunk counter unaffected by explicit call");

    check(with_fn_default(5) == 6, "fn literal as a default");
    check(with_fn_default(5, fn(l: i32): i32 => l * 10) == 50, "fn default overridden");
}

// ---------- variadics ----------

fn has_three(xs: ..any): bool { return len(xs) == 3; }
fn tag_and_two(tag: i32, xs: ..any): bool { return len(xs) == 2; }

fn test_variadic() {
    check(has_three("a", true, 7), "three variadic args");
    check(!has_three(), "no variadic args");
    check(!has_three("a"), "one variadic arg");
    check(tag_and_two(1, "a", "b"), "fixed param plus variadic tail");
}

// ---------- function literals and function types ----------

fn apply(f: fn(l: i32): i32, v: i32): i32 { return f(v); }
fn apply2(f: fn(l: i32, r: i32): i32, x, y: i32): i32 { return f(x, y); }
fn make_adder(): fn(l: i32, r: i32): i32 {
    return fn(l: i32, r: i32): i32 => l + r;
}

fn test_fn_literals() {
    triple := fn(tq: i32): i32 => tq * 3;
    check(triple(4) == 12, "expression-bodied literal in a variable");

    plus100 := fn(pq: i32): i32 { return pq + 100; };
    check(plus100(1) == 101, "block-bodied literal in a variable");

    check((fn(iq: i32): i32 => iq + 1)(1) == 2, "immediately called literal");

    check(apply(fn(aq: i32): i32 => aq * 3, 4) == 12, "literal as argument");
    check(apply(fn(bq: i32): i32 { return bq - 1; }, 4) == 3, "block literal as argument");
    check(apply2(fn(l: i32, r: i32): i32 => l * r, 6, 7) == 42, "two-arg fn type");

    adder := make_adder();
    check(adder(2, 3) == 5, "returned function");

    op: fn(l: i32, r: i32): i32 = fn(l: i32, r: i32): i32 => l - r;
    check(op(9, 4) == 5, "variable with explicit fn type");
    op = make_adder();
    check(op(9, 4) == 13, "reassigned fn variable");

    named_ref: fn(a: i32, b: i32): i32 = add;
    check(named_ref(20, 22) == 42, "top-level fn as a value");
}

// ---------- structs: `a, b: type` ----------

struct Vec3 { x, y, z: i32 }
struct Tagged { name: string, a, b: i32, ok: bool }

fn dot(u: Vec3, w: Vec3): i32 { return u.x * w.x + u.y * w.y + u.z * w.z; }
fn make_vec(vx, vy, vz: i32): Vec3 { return Vec3{x = vx, y = vy, z = vz}; }

fn test_structs() {
    pos := Vec3{1, 2, 3};
    named := Vec3{x = 4, y = 5, z = 6};
    check(dot(pos, named) == 32, "positional and named literals");

    built := make_vec(7, 8, 9);
    check(built.z == 9, "struct returned from a function");

    tag := Tagged{"hi", 1, 2, true};
    check(tag.b == 2 && tag.ok, "group between other fields");
}

fn main() {
    test_basic();
    test_pointer_params();
    test_slice_params();
    test_grouped();
    test_named_args();
    test_defaults();
    test_variadic();
    test_fn_literals();
    test_structs();

    if failures == 0 {
        println("functions: all passed");
    } else {
        println("functions: FAILED");
    }
}
