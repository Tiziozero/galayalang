extern fn printf(fmt: ^byte, data: ..i32): i32;

fn abc(a: i64, b: $T, c:..byte): i32 {
    v := a
    for i in c { v += cast(i64)i }
    return cast(i32)v
}
fn main(): i32 {
    printf(&("number: %d\n")[0], 42);
    printf(&("numbers: %d %d %d\n")[0], 1, 2, 3);
    return abc(1, 2.2, 1, 2, cast(byte)3, 4);
}
