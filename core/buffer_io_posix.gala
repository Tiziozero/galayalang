// buffer_io.gala
//
// A growable byte buffer with a write side (append) and a read cursor.
//
//   b := buffer_make();
//   buffer_write_string(&b, "GET /index.html HTTP/1.1\r\n");
//   buffer_write_i64(&b, 42);
//
//   line: string = "";
//   if buffer_read_line(&b, &line) { ... }
//   head := buffer_slice_string(&b, 0, 3);      // "GET"
//   buffer_destroy(&b);
//
// Rules:
//   - writes return false if the allocator fails (the buffer stays valid)
//   - reads never go past the end; they return less / false / -1 instead
//   - slices never go out of range; indices are clamped to 0..length
//   - slices and other "view" results point into the buffer: any write may
//     move the data, so don't keep them across writes

import "./core_posix.gala";
import "./mem_posix.gala";
import "./cfunctions_posix.gala";

CHAR_CR: byte = 13;
CHAR_LF: byte = 10;

struct Buffer {
    data: rawptr,
    length: i64,        // bytes written
    capacity: i64,      // bytes allocated
    read_pos: i64,      // read cursor, 0 <= read_pos <= length
    allocator: Allocator,
}


// ============================================================
// Helpers
// ============================================================

fn clamp_index(x: i64, lo: i64, hi: i64): i64 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn buffer_as_string(v: []byte): string {
    return transmute(string)v;
}


// ============================================================
// Create / destroy
// ============================================================

fn buffer_make(capacity: i64 = 64, allocator: Allocator = base_allocator): Buffer {
    b := Buffer{NULL, 0, 0, 0, allocator};
    if capacity > 0 {
        buffer_reserve(&b, capacity);
    }
    return b;
}

// Copy of `s` as the buffer's content, read cursor at the start.
fn buffer_from_string(s: string, allocator: Allocator = base_allocator): Buffer {
    b := buffer_make(len(s), allocator);
    buffer_write_string(&b, s);
    return b;
}
fn buffer_from_bytes(data: []byte): Buffer {
    b := buffer_make(len(data));
    buffer_write_bytes(&b, data);
    return b;
}
fn buffer_wrap(data: []byte): Buffer {
    return Buffer {
        data = cast(rawptr)raw_data(data),
        length = len(data),
        capacity = len(data),
        read_pos = 0,
        allocator = PANIC_ALLOCATOR,
    };
}

fn buffer_destroy(b: ^Buffer) {
    allocator := b^.allocator;
    if b^.data != NULL {
        dealloc(b^.data, cast(u64)b^.capacity, allocator);
    }
    b^ = Buffer{NULL, 0, 0, 0, allocator};
}

// Empties the buffer but keeps the memory.
fn buffer_clear(b: ^Buffer) {
    b^.length = 0;
    b^.read_pos = 0;
}

// Makes room for `extra` more bytes (doubling). false if the allocator fails.
fn buffer_reserve(b: ^Buffer, extra: i64): bool {
    need := b^.length + extra;
    if need <= b^.capacity {
        return true;
    }
    new_capacity := b^.capacity;
    if new_capacity < 16 {
        new_capacity = 16;
    }
    while new_capacity < need {
        new_capacity = new_capacity * 2;
    }
    p := resize(b^.data, cast(u64)b^.capacity, cast(u64)new_capacity, 16, b^.allocator);
    if p == NULL {
        return false;
    }
    b^.data = p;
    b^.capacity = new_capacity;
    return true;
}


// ============================================================
// Raw access and slicing
// ============================================================

// Pointer to byte `i` of the buffer (0 = first byte written, not the cursor).
fn buffer_at(b: ^Buffer, i: i64): ^byte {
    raw := ptr_add(b^.data, cast(u64)i);
    return transmute(^byte)raw;
}

// Bytes lo..hi as a view. Indices are clamped, and hi is never below lo.
fn buffer_slice(b: ^Buffer, lo: i64 = -1, hi: i64 = -1): []byte {
    if lo == -1 && hi == -1 {
        return bytes_from(b^.data, b^.length);
    }
    start := clamp_index(lo, 0, b^.length);
    stop := clamp_index(hi, start, b^.length);
    raw := ptr_add(b^.data, cast(u64)start);
    return bytes_from(raw, stop - start);
}

fn buffer_slice_string(b: ^Buffer, lo: i64, hi: i64): string {
    return buffer_as_string(buffer_slice(b, lo, hi));
}

// Bytes from `lo` to the end.
fn buffer_slice_from(b: ^Buffer, lo: i64): []byte {
    return buffer_slice(b, lo, b^.length);
}

// Everything written so far.
fn buffer_bytes(b: ^Buffer): []byte {
    return buffer_slice(b, 0, b^.length);
}

fn buffer_string(b: ^Buffer): string {
    return buffer_as_string(buffer_bytes(b));
}

// What is left to read (from the cursor to the end).
fn buffer_unread(b: ^Buffer): []byte {
    return buffer_slice(b, b^.read_pos, b^.length);
}

// Copy of everything written so far.
fn buffer_to_string(b: ^Buffer, allocator: Allocator = base_allocator): string {
    return clone_string(buffer_string(b), allocator);
}


// ============================================================
// Write
// ============================================================

fn buffer_write_raw(b: ^Buffer, p: rawptr, n: i64): bool {
    if n <= 0 {
        return true;
    }
    if !buffer_reserve(b, n) {
        return false;
    }
    mem_copy(ptr_add(b^.data, cast(u64)b^.length), p, cast(u64)n);
    b^.length += n;
    return true;
}

// Raw bytes of any value.
fn buffer_write(b: ^Buffer, v: $T): bool {
    copy := v;
    return buffer_write_raw(b, cast(rawptr)&copy, size_of(v));
}

fn buffer_write_byte(b: ^Buffer, c: byte): bool {
    if !buffer_reserve(b, 1) {
        return false;
    }
    dst := buffer_at(b, b^.length);
    dst^ = c;
    b^.length += 1;
    return true;
}

fn buffer_write_bytes(b: ^Buffer, s: []byte): bool {
    if len(s) == 0 {
        return true;
    }
    return buffer_write_raw(b, transmute(rawptr)&s[0], len(s));
}

fn buffer_write_string(b: ^Buffer, s: string): bool {
    if len(s) == 0 {
        return true;
    }
    return buffer_write_raw(b, transmute(rawptr)&s[0], len(s));
}

// Decimal text, e.g. 1234 -> "1234".
fn buffer_write_u64(b: ^Buffer, v: u64): bool {
    digits: i64 = 1;
    rest := v / 10;
    while rest > 0 {
        digits += 1;
        rest = rest / 10;
    }
    if !buffer_reserve(b, digits) {
        return false;
    }
    i := digits;
    x := v;
    while i > 0 {
        i -= 1;
        dst := buffer_at(b, b^.length + i);
        dst^ = cast(byte)(CHAR_ZERO + x % 10);
        x = x / 10;
    }
    b^.length += digits;
    return true;
}

fn buffer_write_i64(b: ^Buffer, v: i64): bool {
    if v < 0 {
        if !buffer_write_byte(b, CHAR_MINUS) {
            return false;
        }
        // negate in u64 so i64 min works
        return buffer_write_u64(b, cast(u64)0 - cast(u64)v);
    }
    return buffer_write_u64(b, cast(u64)v);
}

// Appends "\r\n" (HTTP line ending).
fn buffer_write_crlf(b: ^Buffer): bool {
    if !buffer_write_byte(b, CHAR_CR) {
        return false;
    }
    return buffer_write_byte(b, CHAR_LF);
}


// ============================================================
// Read
// ============================================================

fn buffer_remaining(b: ^Buffer): i64 {
    return b^.length - b^.read_pos;
}

// Moves the cursor. false (and no change) if `pos` is outside 0..length.
fn buffer_seek(b: ^Buffer, pos: i64): bool {
    if pos < 0 || pos > b^.length {
        return false;
    }
    b^.read_pos = pos;
    return true;
}

fn buffer_skip(b: ^Buffer, n: i64) {
    b^.read_pos += clamp_index(n, 0, buffer_remaining(b));
}

fn buffer_read(b: ^Buffer, dst: ^$T): bool {
    n := size_of(T);
    count := clamp_index(n, 0, buffer_remaining(b));
    if count != n {
        return false;
    }
    mem_copy(cast(rawptr)dst, ptr_add(b^.data, cast(u64)b^.read_pos), cast(u64)count);
    b^.read_pos += count;
    return true;
}
// Copies up to `n` bytes into `dst`. Returns how many were copied.
fn buffer_read_raw(b: ^Buffer, dst: rawptr, n: i64): i64 {
    count := clamp_index(n, 0, buffer_remaining(b));
    if count == 0 {
        return 0;
    }
    mem_copy(dst, ptr_add(b^.data, cast(u64)b^.read_pos), cast(u64)count);
    b^.read_pos += count;
    return count;
}

// Next byte, or -1 at the end.
fn buffer_read_byte(b: ^Buffer): i32 {
    c := buffer_peek_byte(b);
    if c >= 0 {
        b^.read_pos += 1;
    }
    return c;
}

// Next byte without moving the cursor, or -1 at the end.
fn buffer_peek_byte(b: ^Buffer): i32 {
    if b^.read_pos >= b^.length {
        return -1;
    }
    src := buffer_at(b, b^.read_pos);
    return cast(i32)(src^);
}

// Up to `n` bytes as a view (no copy), moving the cursor past them.
fn buffer_take(b: ^Buffer, n: i64): []byte {
    count := clamp_index(n, 0, buffer_remaining(b));
    v := buffer_slice(b, b^.read_pos, b^.read_pos + count);
    b^.read_pos += count;
    return v;
}

// Distance from the cursor to the next `c`, or -1 if there is none.
fn buffer_find(b: ^Buffer, c: byte): i64 {
    i := b^.read_pos;
    while i < b^.length {
        p := buffer_at(b, i);
        if p^ == c {
            return i - b^.read_pos;
        }
        i += 1;
    }
    return -1;
}

// Reads one line ending in "\n" or "\r\n" (line ending not included) into
// `out` as a view. If there is no complete line yet it returns false and
// the cursor doesn't move, so you can wait for more data and try again.
fn buffer_read_line(b: ^Buffer, out: ^string): bool {
    offset := buffer_find(b, CHAR_LF);
    if offset < 0 {
        return false;
    }
    start := b^.read_pos;
    line_end := start + offset;
    if offset > 0 {
        prev := buffer_at(b, line_end - 1);
        if prev^ == CHAR_CR {
            line_end -= 1;
        }
    }
    out^ = buffer_slice_string(b, start, line_end);
    b^.read_pos = start + offset + 1;
    return true;
}

// Drops the bytes already read, so a long-lived buffer doesn't grow forever.
fn buffer_compact(b: ^Buffer) {
    if b^.read_pos == 0 {
        return;
    }
    left := buffer_remaining(b);
    if left > 0 {
        mem_copy(b^.data, ptr_add(b^.data, cast(u64)b^.read_pos), cast(u64)left);
    }
    b^.length = left;
    b^.read_pos = 0;
}
