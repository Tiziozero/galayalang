import "core/core.gala";

// Helper module for test_generics_import.gala. Not a test by itself.

lib_counter := 0;

struct LibPair { a, b: i64 }
struct LibV2 { x, y: f32 }

// non generic helpers only the generics below call (must resolve in THIS module)
fn lib_helper(x: i64): i64 { return x + 1000; }
fn lib_bump() { lib_counter += 1; }
fn lib_count(): i64 { return lib_counter; }

fn lib_id(a: $T): T { return a; }
fn lib_add(a: $T, b: T): T { return a + b; }
fn lib_swap(a: ^$T, b: ^T) {
    tmp : T = a^;
    a^ = b^;
    b^ = tmp;
}
fn lib_sum(a: []$T): T {
    total : T = cast(T)0;
    for i in a { total = total + i; }
    return total;
}
fn lib_apply(a: $T, f: fn(x: T): T): T { return f(a); }
fn lib_size(a: $T): i64 { return size_of(T); }
fn lib_type_tag(a: $T): i64 { return type_id(T); }

// generic -> generic inside the module
fn lib_add_twice(a: $T, b: T): T { return lib_add(lib_add(a, b), b); }

// generic -> non generic helper of this module
fn lib_uses_helper(a: $T): i64 { return lib_helper(cast(i64)a); }

// generic touching a module global (one global, not one per instantiation)
fn lib_counted(a: $T): T {
    lib_bump();
    return a;
}

// generic returning a type declared in this module
fn lib_make_pair(a: $T, b: T): LibPair { return LibPair{cast(i64)a, cast(i64)b}; }

// default arg on a generic from another module
fn lib_pad(a: $T, n: i64 = 5): i64 { return cast(i64)a + n; }

fn lib_vsum(data: ..$T): T {
    t : T = cast(T)0;
    for i in data { t += i; }
    return t;
}

// duck typing against structs from the caller's module
fn lib_dot(a: $A, b: $B): f32 { return a.x * b.x + a.y * b.y; }

// instantiation made from inside the lib (same one the importer asks for)
fn lib_nongeneric_calls_generic(): i32 { return lib_add(cast(i32)20, cast(i32)22); }
fn lib_nongeneric_i64(): i64 { return lib_add(1, 2); }
