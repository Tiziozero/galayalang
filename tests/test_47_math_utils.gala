fn abs_i32(x: i32): u32 {
    if x {
        neg := -x;
        if neg {
            return neg as u32;
        }
        return x as u32;
    }
    return 0;
}

fn lerp(a, b: i32, t_num, t_den: i32): i32 {
    diff := b - a;
    scaled := diff * t_num;
    return a + scaled / t_den;
}

fn sign(x: i32): i32 {
    if x {
        neg := -x;
        if neg {
            return -1;
        }
        return 1;
    }
    return 0;
}

fn main(): i32 {
    a := abs_i32(-42) as i32;
    b := abs_i32(7) as i32;
    c := lerp(0, 100, 1, 4);
    d := lerp(-50, 50, 3, 4);
    s1 := sign(-99);
    s2 := sign(0);
    s3 := sign(1);
    return a + b + c + d + s1 + s2 + s3;
}
