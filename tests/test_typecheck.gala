// test_typecheck.gala: programs the type checker must ACCEPT (and that must then run correctly).
// Programs it must REJECT live in typecheck_fail.txt (run them with run_typecheck_fail.sh).
// No shadowing anywhere: every name is unique within its scope chain. Parameter names inside
// fn types and fn literals count too. Sibling scopes may reuse a name (see test_sibling_scopes).
// Slicing a string currently gives a []byte; that's expected for now.

import "core/core.gala";

failures := 0;

fn check(ok: bool, name: string) {
    if !ok {
        failures += 1;
        println("FAIL:", name);
    }
}

// ---------- types and helpers ----------

struct Pt { x, y: i32 }
struct Line { a, b: Pt }
struct Holder { vals: [3]i32, name: string, ptr: ^i32 }
struct Mixed { small: u8, wide: i64, ratio: f64, ok: bool }
struct Op { run: fn(l: i32): i32 }

fn double_it(n: i32): i32 { return n * 2; }
fn void_fn() {}
fn echo_ptr(src: ^i32): ^i32 { return src; }
fn bump_pt(target: ^Pt) { target^.x += 50; }
fn swap_pt(pin: Pt): Pt { return Pt{pin.y, pin.x}; }
fn sum_view(xs: []i32): i32 {
    total: i32 = 0;
    for v in xs { total += v; }
    return total;
}

fn ret_u8(): u8 { return 200; }
fn ret_f64(): f64 { return 1; }
fn ret_neg(): i32 { return -7; }

fn count_any(xs: ..any): i64 { return len(xs); }
fn take_any(item: any): bool { return true; }

// parameter defaults whose type is inferred or converted from an untyped literal
fn def_int(dv := 5): i64 { return dv; }
fn def_float(dv := 1.5): f64 { return dv; }
fn def_bool(dv := true): bool { return dv; }
fn def_late(dv: i32 = tg_late): i32 { return dv; }
fn def_widen(dv: f64 = 3): f64 { return dv; }
fn def_text(dv: string = "dflt"): i64 { return len(dv); }

// ---------- globals ----------

tg_first := 10;
tg_second := tg_first + 5;
tg_float := 2.5;
tg_small: u8 = 200;
tg_target: i32 = 7;
tg_ptr: ^i32 = &tg_target;

fn read_late(): i32 { return tg_late; }
tg_late: i32 = 99; // declared after the function that reads it

fn test_globals() {
    check(tg_first == 10, "global inferred from an untyped int");
    check(tg_second == 15, "global inferred from an earlier global");
    check(tg_float == 2.5, "global inferred from an untyped float");
    check(tg_small == 200, "global with an explicit type");
    check(tg_ptr^ == 7, "global pointer to a global");
    check(read_late() == 99, "function reads a global declared below it");
    tg_first += 1;
    check(tg_first == 11, "compound assignment to a global");
}

// ---------- untyped literals ----------

fn test_untyped_literals() {
    small: u8 = 255;
    check(small == 255, "int literal into u8");
    wide: i64 = 5000000000;
    check(wide == 5000000000, "large literal into i64");
    as_float: f64 = 3;
    check(as_float == 3.0, "int literal into f64");
    dec_int := 7;
    check(dec_int == 7, "inferred integer");
    dec_float := 2.5;
    check(dec_float == 2.5, "inferred float");
    promoted := 1 + 2.5;
    check(promoted == 3.5, "untyped int + untyped float is a float");
    folded: f64 = 1 + 2;
    check(folded == 3.0, "untyped int expression into f64");
    neg: i32 = -5;
    check(neg == -5, "negative literal into i32");
    hex_small: u8 = 0xff;
    check(hex_small == 255, "hex literal into u8");
}

// ---------- typed operands mixed with literals ----------

fn test_typed_arithmetic() {
    narrow: i32 = 5;
    check(narrow + 1 == 6, "typed + literal");
    check(1 + narrow == 6, "literal + typed");
    check(narrow * 2 - 1 == 9, "chain of typed and literal");
    check(narrow + narrow == 10, "same types");
    check(-narrow == -5, "unary minus on a typed value");

    wide: i64 = 10;
    check(wide / 4 == 2, "i64 / literal");

    real: f64 = 1.5;
    check(real * 2 == 3.0, "f64 * int literal");
    check(real + 1 == 2.5, "f64 + int literal");
    check(real > 1, "f64 compared with an int literal");

    byte_v: u8 = 250;
    check(byte_v + 5 == 255, "u8 + literal");
}

// ---------- explicit conversions ----------

fn test_conversions() {
    seven: i32 = 7;
    widened: i64 = cast(i64) seven + 1;
    check(widened == 8, "cast then add a literal");
    as_real := cast(f64) seven;
    check(as_real == 7.0, "i32 to f64");
    real_val: f64 = 9.75;
    truncated := cast(i32) real_val;
    check(truncated == 9, "f64 to i32 truncates");
    total: i64 = cast(i64) seven + widened;
    check(total == 15, "cast so both sides are i64");
}

// ---------- pointers ----------

fn test_pointers() {
    cell: i32 = 1;
    p := &cell;
    q: ^i32 = &cell;
    check(p == q, "same pointer type compares");
    check(!(p != q), "!= on same pointer type");

    // pointer + int is a BYTE offset (no scaling by the element size)
    arr := [3]i32{10, 20, 30};
    base := &arr[0];
    next := base + 4;
    check(next^ == 20, "pointer + int is a byte offset");
    check(next > base, "pointers order");
    check((next - 4) == base, "pointer - int");
    after := 8 + base;
    check(after^ == 30, "int + pointer is a byte offset");

    cursor := base;
    cursor += 4;
    check(cursor^ == 20, "pointer += int");
    cursor += 4;
    check(cursor^ == 30, "pointer += int twice");
    cursor -= 8;
    check(cursor == base, "pointer -= int");

    nul: ^i32 = 0;
    check(nul != base, "untyped 0 into a pointer");

    pp := &p;
    check(pp^^ == 1, "pointer to pointer");
}
fn test_pointer_indexing() {
    arr := [3]i32{10, 20, 30};
    base := &arr[0];
    check(base[0] == 10 && base[2] == 30, "index through a pointer");
    base[1] = 21;
    check(arr[1] == 21, "write through a pointer index");
    idx: i64 = 2;
    check(base[idx] == 30, "i64 index on a pointer");
}

// ---------- structs ----------

fn test_structs() {
    mixed := Mixed{small = 200, wide = 5000000000, ratio = 1, ok = true};
    check(mixed.small == 200 && mixed.wide == 5000000000, "named literal with untyped ints");
    check(mixed.ratio == 1.0, "int literal into an f64 field");
    positional := Mixed{1, 2, 3.5, false};
    check(positional.ratio == 3.5 && !positional.ok, "positional literal with untyped values");

    ln := Line{Pt{1, 2}, Pt{3, 4}};
    check(ln.b.y == 4, "nested positional literals");

    hold := Holder{vals = [3]i32{1, 2, 3}, name = "n", ptr = &tg_target};
    check(hold.vals[2] == 3, "array field");
    check(hold.ptr^ == 7, "pointer field");
    hold.vals[0] = 9;
    check(hold.vals[0] == 9, "write into an array field");
    hold.name = "other";
    check(len(hold.name) == 5, "string field");

    copy := ln;
    copy.a.x = 100;
    check(ln.a.x == 1 && copy.a.x == 100, "struct assignment copies");

    ln = Line{Pt{5, 6}, Pt{7, 8}};
    check(ln.a.x == 5, "assign a literal to a struct variable");

    pt := Pt{1, 2};
    bump_pt(&pt);
    check(pt.x == 51, "pointer to a struct as an argument");
    check(swap_pt(Pt{1, 2}).x == 2, "struct in, struct out, field of the call");
}

// ---------- arrays and slices ----------

fn test_arrays_and_slices() {
    grid := [2][2]i32{[2]i32{1, 2}, [2]i32{3, 4}};
    check(grid[1][0] == 3, "array of arrays");
    grid[0][1] = 20;
    check(grid[0][1] == 20, "write into an array of arrays");

    ints := [4]i32{1, 2, 3, 4};
    view: []i32 = ints[1:3];
    check(len(view) == 2 && view[0] == 2, "array slice into a []i32 variable");
    sub := view[1:];
    check(len(sub) == 1 && sub[0] == 3, "slice of a slice");
    check(sum_view(ints[:]) == 10, "array slice as an argument");
    check(sum_view(view) == 5, "slice as an argument");
    check(len(ints) == 4, "len of an array");

    idx64: i64 = 2;
    check(ints[idx64] == 3, "i64 index");
    idx32: i32 = 1;
    check(ints[idx32] == 2, "i32 index");
    ints[idx32 + 1] = 30;
    check(ints[2] == 30, "computed index on the left of =");

    text := "hello";
    chunk: string = text[1:4];
    check(len(chunk) == 3 && chunk[0] == 101, "string slice is a []byte for now");
    first: byte = text[0];
    check(first == 104, "string index is a byte");
}

// ---------- function values ----------

fn test_function_values() {
    renamed: fn(fp_in: i32): i32 = double_it;
    check(renamed(4) == 8, "param names in fn types don't matter");

    no_ret: fn() = void_fn;
    no_ret();

    fp_cell: i32 = 3;
    ptr_fn: fn(fp_src: ^i32): ^i32 = echo_ptr;
    check(ptr_fn(&fp_cell)^ == 3, "pointer params and results in fn types");

    struct_fn: fn(fp_pin: Pt): Pt = swap_pt;
    check(struct_fn(Pt{1, 2}).x == 2, "struct params and results in fn types");

    op := Op{run = double_it};
    check(op.run(5) == 10, "call a fn stored in a struct field");
    op.run = fn(lq: i32): i32 => lq + 1;
    check(op.run(5) == 6, "assign a fn literal to a fn field");
}

// ---------- defaults ----------

fn test_defaults() {
    check(def_int() == 5, "inferred int default is i64");
    check(def_int(9) == 9, "inferred int default overridden");
    check(def_int(dv = 3) == 3, "inferred int default overridden by name");
    check(def_float() == 1.5, "inferred float default");
    check(def_float(2) == 2.0, "untyped int into an inferred f64 param");
    check(def_bool(), "inferred bool default");
    check(!def_bool(false), "inferred bool default overridden");
    check(def_late() == 99, "default reads a global declared later");
    check(def_widen() == 3.0, "int literal default into an f64 param");
    check(def_text() == 4, "string default");
}

// ---------- any ----------

fn test_any() {
    cell: i32 = 1;
    check(count_any() == 0, "no variadic args");
    check(count_any(1, 2.5, "s", true, cell) == 5, "mixed boxing in a variadic tail");
    check(take_any(cell), "typed variable into any");
    check(take_any(&cell), "pointer into any");
    check(take_any(tg_small), "u8 into any");
    check(take_any(Pt{1, 2}), "struct into any");
    check(take_any(1.5), "untyped float into any");
    check(take_any(7), "untyped int into any");
}

// ---------- conditions and returns ----------

fn test_conditions() {
    small: u8 = 3;
    flag: bool = small > 2 && small < 4;
    check(flag, "bool from a comparison of u8 and literals");
    check(!(small == 4), "! on a comparison");
    check(true == (small == 3), "bool == bool");
    check((small == 3) != (small == 4), "bool != bool");

    hits: i32 = 0;
    if small == 3 { hits += 1; }
    while hits < 3 { hits += 1; }
    check(hits == 3, "comparison with literals as conditions");
}

fn test_returns() {
    check(ret_u8() == 200, "literal returned as u8");
    check(ret_f64() == 1.0, "int literal returned as f64");
    check(ret_neg() == -7, "negative literal returned as i32");
}

// ---------- the one place that reuses a name: siblings, not shadowing ----------

fn test_sibling_scopes() {
    total: i32 = 0;
    if true { tmp: i32 = 1; total += tmp; }
    if true { tmp: i32 = 2; total += tmp; }
    for it in [2]i32{1, 2} { total += it; }
    for it in [2]i32{3, 4} { total += it; }
    check(total == 13, "sibling blocks and loops may reuse a name");
}

fn main() {
    test_globals();
    test_untyped_literals();
    test_typed_arithmetic();
    test_conversions();
    test_pointers();
    test_pointer_indexing();
    test_structs();
    test_arrays_and_slices();
    test_function_values();
    test_defaults();
    test_any();
    test_conditions();
    test_returns();
    test_sibling_scopes();

    if failures == 0 {
        println("typecheck: all passed");
    } else {
        println("typecheck: FAILED");
    }
}
