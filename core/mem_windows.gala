// mem.gala
//
// Memory helpers and allocators, modelled on Odin's allocator interface.
//
// An Allocator is a callback plus a data pointer. Every operation goes
// through the callback with a mode:
//
//   MODE_ALLOC     size, align       -> zeroed memory, or NULL
//   MODE_FREE      old (old_size)    -> frees `old`
//   MODE_FREE_ALL                    -> frees everything (arena, pool)
//   MODE_RESIZE    old, old_size,
//                  size, align       -> grows/shrinks `old`, or NULL
//
// Rules for every allocator here:
//   - memory from ALLOC / RESIZE is zeroed (new bytes only, for resize)
//   - a failed allocation returns NULL and leaves `old` untouched
//   - freeing NULL is a no-op
//   - `old_size` is only needed by allocators that track bytes (Tracking)
//
// Usage:
//   p := alloc(64);                       // heap, 16-aligned
//   dealloc(p, 64);
//
//   arena := arena_make(1 * MB);
//   a := arena_allocator(&arena);
//   v := new::<v2>(a);                    // ^v2, zeroed
//   xs := make_slice::<f64>(100, a);      // []f64, zeroed
//   arena_destroy(&arena);                // frees it all
//
//   set_allocator(a);                     // make `a` the default

import "./core_windows.gala";
import "./cfunctions_windows.gala";

// ============================================================
// Constants and raw helpers
// ============================================================

KB: u64 = 1024;
MB: u64 = 1048576;
GB: u64 = 1073741824;

fn addr(p: rawptr): u64 {
    return transmute(u64)p;
}

fn from_addr(a: u64): rawptr {
    return transmute(rawptr)a;
}

fn is_power_of_two(x: u64): bool {
    if x == 0 {
        return false;
    }
    return (x & (x - 1)) == 0;
}

fn align_forward(a: u64, align: u64): u64 {
    if align <= 1 {
        return a;
    }
    rem := a % align;
    if rem == 0 {
        return a;
    }
    return a + align - rem;
}

// Largest power of two <= n, capped at 16. Any real alignment of a type
// of size n divides this, so it's a safe alignment for a single T.
fn align_for_size(n: u64): u64 {
    if n >= 16 { return 16; }
    if n >= 8  { return 8; }
    if n >= 4  { return 4; }
    if n >= 2  { return 2; }
    return 1;
}

fn min_u64(a: u64, b: u64): u64 {
    if a < b {
        return a;
    }
    return b;
}

fn max_u64(a: u64, b: u64): u64 {
    if a > b {
        return a;
    }
    return b;
}

fn mem_copy(dst: rawptr, src: rawptr, n: u64) {
    memmove(dst, src, n);
}

fn mem_zero(p: rawptr, n: u64) {
    memset(p, 0, n);
}

fn mem_set(p: rawptr, value: i32, n: u64) {
    memset(p, value, n);
}

fn mem_equal(a: rawptr, b: rawptr, n: u64): bool {
    return memcmp(a, b, n) == 0;
}


// ============================================================
// Building slices from raw memory
// ============================================================

// Mirror of the slice ABI: { ptr, i64 }.
struct RawSlice {
    data: ^byte,
    length: i64,
}

// A []T over `length` elements starting at `ptr`. No allocation.
fn slice_from(ptr: ^$T, length: i64): []T {
    r := RawSlice{transmute(^byte)ptr, length};
    return transmute([]T)r;
}

fn bytes_from(p: rawptr, n: i64): []byte {
    r := RawSlice{transmute(^byte)p, n};
    return transmute([]byte)r;
}


// ============================================================
// Allocator interface
// ============================================================

MODE_ALLOC: i32 = 0;
MODE_FREE: i32 = 1;
MODE_FREE_ALL: i32 = 2;
MODE_RESIZE: i32 = 3;

struct Allocator {
    callback: fn(data: rawptr, mode: i32, size: u64, align: u64, old: rawptr, old_size: u64): rawptr,
    data: rawptr,
}

// The allocator used when a call doesn't name one.
base_allocator: Allocator = heap_allocator();

fn set_allocator(a: Allocator) {
    base_allocator = a;
}

fn alloc(size: u64, align: u64 = 16, a: Allocator = base_allocator): rawptr {
    cb := a.callback;
    return cb(a.data, MODE_ALLOC, size, align, NULL, 0);
}

// `size` is only needed by allocators that track bytes (see Tracking).
fn dealloc(p: rawptr, size: u64 = 0, a: Allocator = base_allocator) {
    if p == NULL {
        return;
    }
    cb := a.callback;
    cb(a.data, MODE_FREE, 0, 0, p, size);
}

fn dealloc_all(a: Allocator = base_allocator) {
    cb := a.callback;
    cb(a.data, MODE_FREE_ALL, 0, 0, NULL, 0);
}

// Grows or shrinks `p` (which may be NULL). On failure returns NULL and
// `p` is still valid.
fn resize(p: rawptr, old_size: u64, new_size: u64, align: u64 = 16, a: Allocator = base_allocator): rawptr {
    cb := a.callback;
    return cb(a.data, MODE_RESIZE, new_size, align, p, old_size);
}

fn alloc_bytes(n: i64, a: Allocator = base_allocator): []byte {
    if n <= 0 {
        return bytes_from(NULL, 0);
    }
    p := alloc(cast(u64)n, a = a);
    if p == NULL {
        return bytes_from(NULL, 0);
    }
    return bytes_from(p, n);
}

fn free_bytes(b: []byte, a: Allocator = base_allocator) {
    n := len(b);
    if n == 0 {
        return;
    }
    dealloc(cast(rawptr)raw_data(b), cast(u64)n, a);
}

// Copies `s` into fresh memory. An empty or failed copy is "".
fn clone_string(s: string, a: Allocator = base_allocator): string {
    n := len(s);
    if n == 0 {
        return "";
    }
    buf := alloc_bytes(n, a = a);
    if len(buf) == 0 {
        return "";
    }
    mem_copy(cast(rawptr)raw_data(buf), cast(rawptr)str_data(s), cast(u64)n);
    return transmute(string)buf;
}

// Like clone_string, plus a trailing 0 byte so it can go to C.
// Free with dealloc(p, len(s) + 1, a).
fn clone_cstring(s: string, a: Allocator =base_allocator): ^byte {
    n := len(s);
    p := alloc(cast(u64)n + 1, a = a);
    if p == NULL {
        return transmute(^byte)NULL;
    }
    if n > 0 {
        mem_copy(p, cast(rawptr)str_data(s), cast(u64)n);
    }
    return transmute(^byte)p;
}

fn free_string(s: string, a: Allocator = base_allocator) {
    n := len(s);
    if n == 0 {
        return;
    }
    dealloc(cast(rawptr)str_data(s), cast(u64)n, a);
}


// ============================================================
// Typed helpers (generic)
// ============================================================

// A zeroed T. T is explicit: new::<v2>(a). Returns NULL (as ^T) on failure.
fn new::<$T>(a: Allocator = base_allocator): ^T {
    size := cast(u64)size_of(T);
    return transmute(^T)alloc(size, align_for_size(size), a);
}

fn del(p: ^$T, a: Allocator = base_allocator) {
    dealloc(transmute(rawptr)p, cast(u64)size_of(T), a);
}

// make_slice::<f64>(10) gives a []f64 of ten zeroes. Empty on failure.
fn make_slice::<$T>(n: i64 = 0, a: Allocator = base_allocator): []T {
    if n <= 0 {
        return slice_from(transmute(^T)NULL, 0);
    }
    size := cast(u64)size_of(T);
    p := alloc(size * cast(u64)n, align_for_size(size), a);
    if p == NULL {
        return slice_from(transmute(^T)NULL, 0);
    }
    return slice_from(transmute(^T)p, n);
}

fn del_slice(s: []$T, a: Allocator = base_allocator) {
    n := len(s);
    if n == 0 {
        return;
    }
    total := cast(u64)size_of(T) * cast(u64)n;
    dealloc(cast(rawptr)raw_data(s), total, a);
}


// ============================================================
// Heap (libc malloc)
// ============================================================

// Alignment above 16 isn't supported (malloc's guarantee): returns NULL.
fn heap_proc(data: rawptr, mode: i32, size: u64, align: u64, old: rawptr, old_size: u64): rawptr {
    if (mode == MODE_ALLOC || mode == MODE_RESIZE) && align > 16 {
        return NULL;
    }

    if mode == MODE_ALLOC {
        return calloc(1, size);
    }
    if mode == MODE_FREE {
        if old != NULL {
            free(old);
        }
        return NULL;
    }
    if mode == MODE_RESIZE {
        if old == NULL {
            return calloc(1, size);
        }
        p := realloc(old, size);
        if p != NULL && size > old_size {
            mem_zero(ptr_add(p, old_size), size - old_size);
        }
        return p;
    }
    // MODE_FREE_ALL: the heap can't free everything
    return NULL;
}

fn heap_allocator(): Allocator {
    return Allocator{heap_proc, NULL};
}


// ============================================================
// Arena (bump allocator over one fixed buffer)
// ============================================================

// Freeing the newest allocation gives its bytes back; freeing anything
// else is a no-op. MODE_FREE_ALL resets the whole arena.
struct Arena {
    buf: rawptr,
    size: u64,
    offset: u64,
    last: u64,    // offset of the latest allocation, for in-place resize/free
    owns: bool,   // buf came from arena_make and is freed by arena_destroy
}

fn arena_empty(): Arena {
    return Arena{NULL, 0, 0, 0, false};
}

// Arena over memory you already have (stack buffer, another allocation).
fn arena_init(a: ^Arena, buf: rawptr, size: u64) {
    a^ = Arena{buf, size, 0, 0, false};
}

// Arena over a fresh malloc'd buffer. If malloc fails the arena is empty
// (every allocation returns NULL).
fn arena_make(size: u64): Arena {
    buf := malloc(size);
    if buf == NULL {
        return arena_empty();
    }
    return Arena{buf, size, 0, 0, true};
}

fn arena_destroy(a: ^Arena) {
    if a^.owns {
        free(a^.buf);
    }
    a^ = arena_empty();
}

fn arena_reset(a: ^Arena) {
    a^.offset = 0;
    a^.last = 0;
}

fn arena_used(a: ^Arena): u64 {
    return a^.offset;
}

fn arena_remaining(a: ^Arena): u64 {
    return a^.size - a^.offset;
}

// Scratch scopes: take a mark, allocate, restore to free everything since.
fn arena_mark(a: ^Arena): u64 {
    return a^.offset;
}

fn arena_restore(a: ^Arena, mark: u64) {
    a^.offset = mark;
    a^.last = mark;
}

// Bumps the offset. Written so a huge `size` can't overflow the bounds check.
fn arena_push(a: ^Arena, size: u64, align: u64): rawptr {
    base := addr(a^.buf);
    limit := base + a^.size;
    start := align_forward(base + a^.offset, align);
    if start > limit || size > limit - start {
        return NULL;
    }
    a^.offset = start + size - base;
    a^.last = start - base;
    p := from_addr(start);
    mem_zero(p, size);
    return p;
}

fn arena_proc(data: rawptr, mode: i32, size: u64, align: u64, old: rawptr, old_size: u64): rawptr {
    a := transmute(^Arena)data;

    if mode == MODE_ALLOC {
        return arena_push(a, size, align);
    }
    if mode == MODE_FREE_ALL {
        arena_reset(a);
        return NULL;
    }
    if mode == MODE_FREE {
        if old != NULL && addr(old) == addr(a^.buf) + a^.last {
            a^.offset = a^.last;
        }
        return NULL;
    }
    if mode == MODE_RESIZE {
        if old == NULL {
            return arena_push(a, size, align);
        }
        // the latest allocation can grow or shrink where it is
        if addr(old) == addr(a^.buf) + a^.last && size <= a^.size - a^.last {
            if size > old_size {
                mem_zero(ptr_add(old, old_size), size - old_size);
            }
            a^.offset = a^.last + size;
            return old;
        }
        p := arena_push(a, size, align);
        if p == NULL {
            return NULL;
        }
        mem_copy(p, old, min_u64(old_size, size));
        return p;
    }
    return NULL;
}

fn arena_allocator(a: ^Arena): Allocator {
    return Allocator{arena_proc, transmute(rawptr)a};
}


// ============================================================
// Temp allocator (one global arena, reset it every frame/iteration)
// ============================================================

temp_arena: Arena = Arena{NULL, 0, 0, 0, false};

// Optional: pick the size (default 4 MB, created on first use).
fn temp_init(size: u64) {
    if temp_arena.buf != NULL {
        arena_destroy(&temp_arena);
    }
    temp_arena = arena_make(size);
}

fn temp_allocator(): Allocator {
    if temp_arena.buf == NULL {
        temp_init(4 * MB);
    }
    return arena_allocator(&temp_arena);
}

fn temp_reset() {
    arena_reset(&temp_arena);
}


// ============================================================
// Pool (fixed-size chunks with an intrusive free list)
// ============================================================

// Chunks are 16-aligned and at least 16 bytes. Allocation is O(1), and a
// freed pointer is checked to be a chunk of this pool (double frees aren't
// detected).
struct Pool {
    buf: rawptr,
    chunk_size: u64,
    count: u64,
    free_head: rawptr,
    used: u64,
}

fn link_get(chunk: rawptr): rawptr {
    pp := transmute(^rawptr)chunk;
    return pp^;
}

fn link_set(chunk: rawptr, next: rawptr) {
    pp := transmute(^rawptr)chunk;
    pp^ = next;
}

// Puts every chunk back on the free list, first chunk first.
fn pool_reset(p: ^Pool) {
    p^.free_head = NULL;
    p^.used = 0;
    if p^.buf == NULL {
        return;
    }
    base := addr(p^.buf);
    i := p^.count;
    while i > 0 {
        i -= 1;
        chunk := from_addr(base + i * p^.chunk_size);
        link_set(chunk, p^.free_head);
        p^.free_head = chunk;
    }
}

// If malloc fails (or the total size overflows) the pool is empty:
// every allocation returns NULL.
fn pool_make(chunk_size: u64, count: u64): Pool {
    cs := max_u64(align_forward(chunk_size, 16), 16);
    max_value := cast(u64)0 - cast(u64)1;
    if count == 0 || count > max_value / cs {
        return Pool{NULL, cs, 0, NULL, 0};
    }
    buf := malloc(cs * count);
    if buf == NULL {
        return Pool{NULL, cs, 0, NULL, 0};
    }
    pl := Pool{buf, cs, count, NULL, 0};
    pool_reset(&pl);
    return pl;
}

fn pool_destroy(p: ^Pool) {
    free(p^.buf);
    p^ = Pool{NULL, 0, 0, NULL, 0};
}

fn pool_owns(p: ^Pool, ptr: rawptr): bool {
    if p^.buf == NULL {
        return false;
    }
    start := addr(p^.buf);
    x := addr(ptr);
    if x < start {
        return false;
    }
    off := x - start;
    if off >= p^.chunk_size * p^.count {
        return false;
    }
    return (off % p^.chunk_size) == 0;
}

fn pool_proc(data: rawptr, mode: i32, size: u64, align: u64, old: rawptr, old_size: u64): rawptr {
    p := transmute(^Pool)data;

    if mode == MODE_ALLOC {
        if size > p^.chunk_size || align > 16 || p^.free_head == NULL {
            return NULL;
        }
        chunk := p^.free_head;
        p^.free_head = link_get(chunk);
        p^.used += 1;
        mem_zero(chunk, p^.chunk_size);
        return chunk;
    }
    if mode == MODE_FREE {
        if old == NULL || !pool_owns(p, old) {
            return NULL;
        }
        link_set(old, p^.free_head);
        p^.free_head = old;
        if p^.used > 0 {
            p^.used -= 1;
        }
        return NULL;
    }
    if mode == MODE_FREE_ALL {
        pool_reset(p);
        return NULL;
    }
    if mode == MODE_RESIZE {
        // chunks never change size: keep the same chunk if it still fits
        if old != NULL && size <= p^.chunk_size {
            if size > old_size {
                mem_zero(ptr_add(old, old_size), size - old_size);
            }
            return old;
        }
        return NULL;
    }
    return NULL;
}

fn pool_allocator(p: ^Pool): Allocator {
    return Allocator{pool_proc, transmute(rawptr)p};
}


// ============================================================
// Tracking (wraps another allocator and counts)
// ============================================================

// Byte counts only stay accurate if frees pass the size (see dealloc;
// the typed helpers del / del_slice do that for you).
struct Tracking {
    backing: Allocator,
    allocs: i64,
    frees: i64,
    fails: i64,
    live: i64,
    peak: i64,
    total: i64,
}

fn tracking_init(t: ^Tracking, backing: Allocator) {
    t^ = Tracking{backing, 0, 0, 0, 0, 0, 0};
}

// Clears the counters, keeps the backing allocator.
fn tracking_reset(t: ^Tracking) {
    tracking_init(t, t^.backing);
}

fn tracking_proc(data: rawptr, mode: i32, size: u64, align: u64, old: rawptr, old_size: u64): rawptr {
    t := transmute(^Tracking)data;
    b := t^.backing;
    cb := b.callback;
    p := cb(b.data, mode, size, align, old, old_size);

    if mode == MODE_ALLOC {
        if p != NULL {
            t^.allocs += 1;
            t^.live += cast(i64)size;
            t^.total += cast(i64)size;
        } else {
            t^.fails += 1;
        }
    } else if mode == MODE_FREE {
        if old != NULL {
            t^.frees += 1;
            t^.live -= cast(i64)old_size;
        }
    } else if mode == MODE_FREE_ALL {
        t^.live = 0;
    } else if mode == MODE_RESIZE {
        if p != NULL {
            t^.live += cast(i64)size - cast(i64)old_size;
            t^.total += cast(i64)size;
        } else {
            t^.fails += 1;
        }
    }
    if t^.live > t^.peak {
        t^.peak = t^.live;
    }
    return p;
}

fn tracking_allocator(t: ^Tracking): Allocator {
    return Allocator{tracking_proc, transmute(rawptr)t};
}

fn tracking_report(t: ^Tracking) {
    println("allocs:", t^.allocs, "frees:", t^.frees, "failed:", t^.fails);
    println("live bytes:", t^.live, "peak:", t^.peak, "total:", t^.total);
}


// ============================================================
// Panic allocator (for buffers that must not be allocated from)
// ============================================================

fn panic_proc(data: rawptr, mode: i32, size: u64, align: u64, old: rawptr, old_size: u64): rawptr {
    eprintln("PANIC: attempted allocation operation on a wrapped buffer");
    exit(1);
    return 0;
}

PANIC_ALLOCATOR := Allocator{
    callback = panic_proc,
    data = 0,
};
