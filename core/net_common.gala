// net_common.gala: types, error kinds and pure helpers shared by
// net_posix.gala and net_windows.gala. Imports nothing.
//
// Every fallible call returns a NetError (or a result struct holding one).
// The error is captured right at the failing call, so nothing can overwrite it.
// kind is portable (NET_ERR_*), os_code is the raw errno / WSA code.
//
//   r := tcp_connect("127.0.0.1", 8080);
//   if !net_ok(r.err) {
//       println("connect failed:", net_error_message(r.err.kind), r.err.os_code);
//       return;
//   }
//   sock := r.sock;
//
// tcp_recv: n > 0 bytes received, n == 0 with no error means the peer closed.

// ============================================================
// Error kinds
// ============================================================

NET_OK: i32 = 0;
NET_ERR_INIT: i32 = 1;            // WSAStartup failed (Windows)
NET_ERR_BAD_ARG: i32 = 2;
NET_ERR_BAD_ADDRESS: i32 = 3;     // not an IPv4 address / not assignable
NET_ERR_ADDR_IN_USE: i32 = 4;
NET_ERR_ACCESS: i32 = 5;
NET_ERR_REFUSED: i32 = 6;
NET_ERR_UNREACHABLE: i32 = 7;
NET_ERR_TIMEOUT: i32 = 8;
NET_ERR_CLOSED: i32 = 9;          // reset, aborted, broken pipe, not connected
NET_ERR_INVALID_SOCKET: i32 = 10;
NET_ERR_RESOURCES: i32 = 11;      // out of fds / buffers / memory
NET_ERR_INTERRUPTED: i32 = 12;
NET_ERR_OTHER: i32 = 13;


// ============================================================
// Types
// ============================================================

struct NetError {
    kind: i32,
    os_code: i32,
}

struct TcpSocket {
    fd: i64,    // -1 = invalid
}

// 16 bytes on both Linux and Windows.
struct SockAddrIn {
    family: u16,
    port: u16,
    address: u32,
    zero: [8]byte,
}

struct SockResult {
    sock: TcpSocket,
    err: NetError,
}

struct IoResult {
    n: i64,
    err: NetError,
}


// ============================================================
// Constructors and predicates
// ============================================================

fn net_no_error(): NetError {
    return NetError{kind=NET_OK, os_code=0};
}

fn net_error(kind: i32, os_code: i32): NetError {
    return NetError{kind=kind, os_code=os_code};
}

fn net_ok(e: NetError): bool {
    return e.kind == NET_OK;
}

fn net_is_timeout(e: NetError): bool {
    return e.kind == NET_ERR_TIMEOUT;
}

fn net_invalid_socket(): TcpSocket {
    return TcpSocket{fd=-1};
}

fn tcp_valid(s: TcpSocket): bool {
    return s.fd >= 0;
}

fn net_sock_ok(s: TcpSocket): SockResult {
    return SockResult{sock=s, err=net_no_error()};
}

fn net_sock_err(e: NetError): SockResult {
    return SockResult{sock=net_invalid_socket(), err=e};
}

fn net_io_ok(n: i64): IoResult {
    return IoResult{n=n, err=net_no_error()};
}

fn net_io_err(e: NetError): IoResult {
    return IoResult{n=-1, err=e};
}


// ============================================================
// Messages
// ============================================================

fn net_error_message(kind: i32): string {
    if kind == NET_OK { return "ok"; }
    if kind == NET_ERR_INIT { return "network stack init failed"; }
    if kind == NET_ERR_BAD_ARG { return "invalid argument"; }
    if kind == NET_ERR_BAD_ADDRESS { return "bad address"; }
    if kind == NET_ERR_ADDR_IN_USE { return "address already in use"; }
    if kind == NET_ERR_ACCESS { return "permission denied"; }
    if kind == NET_ERR_REFUSED { return "connection refused"; }
    if kind == NET_ERR_UNREACHABLE { return "network or host unreachable"; }
    if kind == NET_ERR_TIMEOUT { return "timed out"; }
    if kind == NET_ERR_CLOSED { return "connection closed"; }
    if kind == NET_ERR_INVALID_SOCKET { return "invalid socket"; }
    if kind == NET_ERR_RESOURCES { return "out of resources"; }
    if kind == NET_ERR_INTERRUPTED { return "interrupted"; }
    return "unknown network error";
}


// ============================================================
// IPv4 parsing (no NUL-terminated strings, no inet_addr)
// ============================================================

fn net_str_is(a: string, b: string): bool {
    n := len(a);
    if n != len(b) {
        return false;
    }
    i: i64 = 0;
    while i < n {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

// "a.b.c.d" -> host-order u32 value, or -1 if invalid.
fn net_parse_ipv4(host: string): i64 {
    n := len(host);
    if n == 0 {
        return -1;
    }
    value: i64 = 0;
    part: i64 = 0;
    digits: i64 = 0;
    parts: i64 = 0;
    i: i64 = 0;
    while i < n {
        c := cast(i64)host[i];
        if c >= 48 && c <= 57 {
            part = part * 10 + (c - 48);
            digits += 1;
            if digits > 3 || part > 255 {
                return -1;
            }
        } else if c == 46 {
            if digits == 0 || parts >= 3 {
                return -1;
            }
            value = value * 256 + part;
            parts += 1;
            part = 0;
            digits = 0;
        } else {
            return -1;
        }
        i += 1;
    }
    if digits == 0 || parts != 3 {
        return -1;
    }
    return value * 256 + part;
}

// Like net_parse_ipv4, plus "localhost". Hostname lookup is not supported yet.
fn net_host_to_ipv4(host: string): i64 {
    if net_str_is(host, "localhost") {
        return 2130706433;    // 127.0.0.1
    }
    return net_parse_ipv4(host);
}