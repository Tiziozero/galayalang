// test_expressions.gala: expressions.
// No shadowing anywhere: every name is unique within its scope chain.
// Precedence follows Go/Odin: `* / % & << >>` > `+ - | ~` > comparisons > `&&` > `||`.

import "core/core.gala";

failures := 0;
touched := 0;

fn check(ok: bool, name: string) {
    if !ok {
        failures += 1;
        println("FAIL:", name);
    }
}

fn touch(result: bool): bool {
    touched += 1;
    return result;
}
fn twice(v: i32): i32 { return v * 2; }

struct Pair { first, second: i32 }
struct Wrapper { inner: Pair, tag: i32 }

fn pair_sum(p: Pair): i32 { return p.first + p.second; }

fn test_arithmetic() {
    a: i32 = 17;
    b: i32 = 5;
    check(a + b == 22, "+");
    check(a - b == 12, "-");
    check(a * b == 85, "*");
    check(a / b == 3, "/");
    check(a % b == 2, "%");
    check(-a + b == -12, "unary minus then +");
    check(twice(twice(3)) + 1 == 13, "calls as operands");
    check(-twice(2) == -4, "unary minus on a call");
}

fn test_precedence() {
    check(2 + 3 * 4 == 14, "* before +");
    check((2 + 3) * 4 == 20, "parens");
    check(10 - 3 - 2 == 5, "- is left associative");
    check(100 / 10 / 5 == 2, "/ is left associative");
    check(2 * 3 % 4 == 2, "* and % are left associative");
    check(1 + 2 << 1 == 5, "<< binds tighter than +");
    check(6 & 3 == 2, "& binds tighter than ==");
    check(1 | 2 == 3, "| binds tighter than ==");
    check(5 ~ 1 == 4, "~ (xor) binds tighter than ==");
    check(1 + 2 | 4 == 7, "| and + share a level, left to right");
    check(true || false && false, "&& binds tighter than ||");
    check(1 + 2 == 3 && 4 > 3, "comparison binds tighter than &&");
    check(!false && true, "! binds tighter than &&");
}

fn test_unary() {
    x: i32 = 5;
    flag := true;
    check(-x == 0 - 5, "unary -");
    check(-(-x) == x, "double negation");
    check(+x == x, "unary +");
    check(!(!flag), "double !");
    check(!flag == false, "! binds tighter than ==");
}

fn test_comparisons() {
    lo: i32 = 3;
    hi: i32 = 8;
    check(lo < hi, "<");
    check(hi > lo, ">");
    check(lo <= 3, "<= equal");
    check(lo <= hi, "<= less");
    check(hi >= 8, ">= equal");
    check(hi >= lo, ">= greater");
    check(lo == 3, "==");
    check(lo != hi, "!=");
    check(!(lo > hi), "not >");
    check(true == true, "bool ==");
    check(true != false, "bool !=");
}

fn test_bitwise() {
    m: i32 = 12; // 1100
    k: i32 = 10; // 1010
    check((m & k) == 8, "&");
    check((m | k) == 14, "|");
    check((m ~ k) == 6, "~ (xor)");
    check(m << 2 == 48, "<<");
    check(m >> 2 == 3, ">>");
}

fn test_logic() {
    touched = 0;
    r1 := false && touch(true);
    check(touched == 0 && !r1, "&& short-circuits");
    r2 := true || touch(false);
    check(touched == 0 && r2, "|| short-circuits");
    r3 := true && touch(true);
    check(touched == 1 && r3, "&& evaluates rhs when lhs is true");
    r4 := false || touch(false);
    check(touched == 2 && !r4, "|| evaluates rhs when lhs is false");
}

fn test_compound_assign() {
    v: i32 = 10;
    v += 5;
    check(v == 15, "+=");
    v -= 3;
    check(v == 12, "-=");
    v *= 2;
    check(v == 24, "*=");
    v /= 4;
    check(v == 6, "/=");
    v %= 4;
    check(v == 2, "%=");
    v <<= 3;
    check(v == 16, "<<=");
    v >>= 1;
    check(v == 8, ">>=");
    v |= 3;
    check(v == 11, "|=");
    v &= 6;
    check(v == 2, "&=");
    v ~= 7;
    check(v == 5, "~=");
}

fn test_casts() {
    wide: i64 = 70000;
    narrow := cast(i32) wide;
    check(narrow == 70000, "cast i64 to i32");
    check(-cast(i32) wide == -70000, "unary minus on a cast");

    big: i32 = 300;
    check(cast(u8) big == 44, "cast to u8 truncates");

    neg: i32 = -1;
    check(cast(i64) neg == -1, "cast sign-extends");
    check(cast(u8) neg == 255, "negative to u8");

    pos: i32 = 5;
    check(transmute(u32) pos == 5, "transmute i32 to u32");
    check(transmute(i32) transmute(u32) pos == 5, "nested transmute");

    check(size_of(i32) == 4, "size_of i32");
    check(size_of(i64) == 8, "size_of i64");
    check(size_of(u8) == 1, "size_of u8");
}

fn test_arrays_and_slices() {
    arr := [4]i32{10, 20, 30, 40};
    check(arr[0] == 10 && arr[3] == 40, "array literal and indexing");
    check(len(arr) == 4, "len of array");

    arr[1] = 21;
    check(arr[1] == 21, "index assignment");
    arr[2] += 5;
    check(arr[2] == 35, "index compound assignment");

    zeros := [3]i32{};
    check(zeros[0] == 0 && zeros[2] == 0, "empty initialiser is zeroed");
    part := [4]i32{1, 2,};
    check(part[1] == 2 && part[3] == 0, "partial initialiser, trailing comma");

    mid := arr[1:3];
    check(len(mid) == 2 && mid[0] == 21, "arr[a:b]");
    head := arr[:2];
    check(len(head) == 2 && head[1] == 21, "arr[:b]");
    tail := arr[2:];
    check(len(tail) == 2 && tail[0] == 35, "arr[a:]");
    whole := arr[:];
    check(len(whole) == 4, "arr[:]");

    mid[0] = 99;
    check(arr[1] == 99, "slices alias the array");

    text := "hello";
    check(len(text) == 5, "len of string");
    check(text[1] == 101, "string indexing");
}

fn test_pointers() {
    cell: i32 = 1;
    ptr := &cell;
    check(ptr^ == 1, "deref");
    ptr^ = 2;
    check(cell == 2, "assign through pointer");
    ptr^ += 3;
    check(cell == 5, "compound assign through pointer");
    check(&cell == ptr, "same address");

    pair_arr := [2]i32{7, 8};
    second := &pair_arr[1];
    second^ = 80;
    check(pair_arr[1] == 80, "pointer to an element");
}

fn test_structs() {
    w := Wrapper{inner = Pair{first = 1, second = 2}, tag = 3};
    check(w.inner.second == 2, "nested field read");
    w.inner.first = 10;
    check(w.inner.first == 10, "nested field write");
    w.tag *= 2;
    check(w.tag == 6, "field compound assign");

    inner_ptr := &w.inner;
    inner_ptr^.second = 20;
    check(w.inner.second == 20, "write through pointer to field");

    check(pair_sum(Pair{1, 2}) == 3, "struct literal as call argument");
    check(pair_sum(Pair{first = 4, second = 5}) == 9, "named literal as call argument");
}

fn test_parens() {
    check((1 + 2) * (3 + 4) == 21, "grouped sub-expressions");
    check(((1 + 2)) == 3, "nested parens");
    check((Pair{first = 1, second = 2}).second == 2, "field access on a parenthesised literal");
}

fn test_radix_literals() {
    check(0xff == 255, "hex");
    check(0XAB == 171, "hex, uppercase prefix and digits");
    check(0b101 == 5, "binary");
    check(0B11 == 3, "binary, uppercase prefix");
    check(0x10 + 0b10 == 18, "mixed in an expression");
    wide: i64 = 0x7FFFFFFF;
    check(wide == 2147483647, "hex into i64");
    ratio: f64 = 0x10;
    check(ratio == 16.0, "hex literal converted to f64");
    arr := [0x2]i32{1, 2};
    check(len(arr) == 2, "hex array size");
}

fn main() {
    test_arithmetic();
    test_precedence();
    test_unary();
    test_comparisons();
    test_bitwise();
    test_logic();
    test_compound_assign();
    test_casts();
    test_arrays_and_slices();
    test_pointers();
    test_structs();
    test_parens();
    test_radix_literals();

    if failures == 0 {
        println("expressions: all passed");
    } else {
        println("expressions: FAILED");
    }
}
