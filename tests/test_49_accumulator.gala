struct accum {
    sum, count: u32;
    min, max: i32;
};

fn main(): i32 {
    fn accum_init(a: *accum) {
        (*a).sum = 0;
        (*a).count = 0;
        (*a).min = 999999;
        (*a).max = -999999;
    }

    fn accum_push(a: *accum, v: i32) {
        (*a).sum = (*a).sum + v as u32;
        (*a).count = (*a).count + 1;
        if (*a).min - v {
            (*a).min = v;
        }
        if v - (*a).max {
            (*a).max = v;
        }
    }

    fn accum_mean(a: *accum): u32 {
        if (*a).count {
            return (*a).sum / (*a).count;
        }
        return 0;
    }

    fn accum_range(a: *accum): i32 {
        return (*a).max - (*a).min;
    }

    a: accum;
    accum_init(&a);
    accum_push(&a, 10);
    accum_push(&a, 20);
    accum_push(&a, 30);
    accum_push(&a, -5);
    accum_push(&a, 100);

    mean := accum_mean(&a) as i32;
    range := accum_range(&a);
    return mean + range;
}
