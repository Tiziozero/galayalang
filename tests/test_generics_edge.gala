import "core/core.gala";

// Generics edge cases (single module). Passes iff there are no FAIL lines and it prints "all passed".
// Things that depend on unsettled language design live in test_generics_exotic.gala.
// Remember the no-shadowing rule: every local in main has a unique name.

counter := 0;

fn check(name: string, ok: bool) {
    if !ok {
        println("FAIL:", name);
    }
}

fn next(): i64 {
    counter += 1;
    return counter;
}
fn reset() { counter = 0; }

struct Pair { a: i32, b: i32 }
struct V2 { x, y: f32 }
struct V3 { x, y, z: f32 }
struct IntXY { x, y: i64 }
struct Big { a, b, c, d, e: i64 }
struct Mixed { a: byte, b: i64, c: f32, d: bool }
struct Wrapper { p: ^i64, n: i32 }
struct Nested { pr: Pair, v: V2 }

// ---------------------------------------------------------------- generics

fn id(a: $T): T { return a; }
fn add(a: $T, b: T): T { return a + b; }
fn sub(a: $T, b: T): T { return a - b; }
fn div(a: $T, b: T): T { return a / b; }
fn modulo(a: $T, b: T): T { return a % b; }
fn lt(a: $T, b: T): bool { return a < b; }
fn neg(a: $T): T { return -a; }
fn max2(a: $T, b: T): T { if a > b { return a; } return b; }
fn size_of_t(a: $T): i64 { return size_of(T); }
fn tid(a: $T): i64 { return type_id(T); }

// generic param is not the first one / not used by every param
fn second(a: i32, b: $T): T { return b; }
fn last3(a: $A, b: $B, c: $C): C { return c; }
fn first_of_two(a: $A, b: $B): A { return a; }
fn scale(a: $T, k: i64): T { return a * cast(T)k; }
fn pick(c: bool, a: $T, b: T): T { if c { return a; } return b; }

// pointers
fn addr_of(a: ^$T): ^T { return a; }
fn deref(a: ^$T): T { return a^; }
fn store(p: ^$T, v: T) { p^ = v; }
fn swap(a: ^$T, b: ^T) {
    tmp : T = a^;
    a^ = b^;
    b^ = tmp;
}

// duck typing (two different params, two different struct types)
fn dot(a: $A, b: $B): f64 { return cast(f64)(a.x * b.x + a.y * b.y); }
fn sum_xy(p: ^$T): f64 { return cast(f64)(p^.x + p^.y); }

// casts depend on the instantiated type (sign/zero extension, fptosi, ...)
fn to_i64(a: $T): i64 { return cast(i64)a; }
fn to_f64(a: $T): f64 { return cast(f64)a; }
fn to_byte(a: $T): byte { return cast(byte)a; }

// locals of type T
fn pair_arr_sum(a: $T, b: T): T {
    arr := [2]T{a, b};
    return arr[0] + arr[1];
}
fn inc_via_ptr(a: $T): T {
    v : T = a;
    p := &v;
    p^ = p^ + cast(T)1;
    return v;
}
fn zero_of(a: $T): T {
    z : T = cast(T)0;
    return z;
}

// control flow inside generic bodies
fn clamp(v: $T, lo: T, hi: T): T {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}
fn count_up(n: $T): T {
    i : T = cast(T)0;
    acc : T = cast(T)0;
    while i < n {
        i = i + cast(T)1;
        if i == cast(T)3 { continue; }
        acc = acc + i;
        if acc > cast(T)100 { break; }
    }
    return acc;
}
fn first_even(a: []$T): i64 {
    idx := 0;
    for v in a {
        if modulo(v, cast(T)2) == cast(T)0 { return idx; }
        idx += 1;
    }
    return -1;
}

// side effects / evaluation count and order
fn twice_use(a: $T): T { return a + a; }
fn bump(a: $T): T { counter += 1; return a; }
fn gsub(a: $T, b: T): T { return a - b; }

// slices
fn sum(a: []$T): T {
    total : T = cast(T)0;
    for i in a { total = total + i; }
    return total;
}
fn sum_rec(a: []$T): T {
    if len(a) == 0 { return cast(T)0; }
    return a[0] + sum_rec(a[1:]);
}
fn first(a: []$T): T { return a[0]; }
fn tail(a: []$T): []T { return a[1:]; }
fn take(a: []$T, n: i64): []T { return a[0:n]; }
fn last_ptr(a: []$T): ^T { return &a[len(a) - 1]; }

// function typed params
fn apply(a: $T, f: fn(x: T): T): T { return f(a); }
fn compose2(a: $T, f: fn(x: T): T, g: fn(x: T): T): T { return g(f(a)); }
fn fold(a: []$T, init: T, f: fn(acc: T, x: T): T): T {
    r := init;
    for x in a { r = f(r, x); }
    return r;
}
fn count_if(a: []$T, pred: fn(x: T): bool): i64 {
    n := 0;
    for x in a { if pred(x) { n += 1; } }
    return n;
}
fn call_ptr(p: ^$T, f: fn(q: ^T): T): T { return f(p); }
fn double_i64(x: i64): i64 { return x * 2; }
fn read_i64(q: ^i64): i64 { return q^; }

// generics calling generics (chain, declared "backwards")
fn lvl1(a: $T): T { return lvl2(a); }
fn lvl2(a: $T): T { return lvl3(a); }
fn lvl3(a: $T): T { return a; }

// finite instantiation chain: depth<T> -> depth<i32> -> depth<i32> ...
fn depth(a: $T, n: i64): i64 {
    if n == 0 { return size_of(T); }
    return depth(cast(i32)1, n - 1);
}

// many params, mixed generic / non generic, float + int register classes
fn mix8(a: $A, b: i32, c: $B, d: f32, e: $C, p6: i64, p7: f64, p8: byte): f64 {
    return cast(f64)a + cast(f64)b + cast(f64)c + cast(f64)d + cast(f64)e + cast(f64)p6 + p7 + cast(f64)p8;
}

// used from plain (non generic) functions: instantiation is shared between call sites
fn uses_id_a(): i64 { return id(1); }
fn uses_id_b(): i64 { return id(2) + id(3); }
fn plain(a: i32): i32 { return id(a); }
fn plain_taking(a: i64): i64 { return a + 1; }

// name mangling: a user function that looks like a mangled instance
fn id_i32(a: i32): i32 { return 999; }
fn id__i32(a: i32): i32 { return 998; }

// generic with a bad body that is never instantiated must not be an error
fn never_called(a: $T): T { return a + 34; }

// generic calling a non generic fn declared further down
fn gen_calls_plain(a: $T): i64 { return later_plain(cast(i64)a) + 1; }

fn main() {
    // ---- identity over every numeric type
    check("id i8", id(cast(i8)(-5)) == cast(i8)(-5));
    check("id i16", id(cast(i16)1000) == cast(i16)1000);
    check("id u16", id(cast(u16)60000) == cast(u16)60000);
    check("id u32", id(cast(u32)4000000000) == cast(u32)4000000000);
    check("id u64", id(cast(u64)9000000000000000000) == cast(u64)9000000000000000000);
    check("id neg literal", id(-1) == -1);
    check("id zero", id(0) == 0);

    // ---- size_of(T) per instantiation
    check("size_of i8", size_of_t(cast(i8)1) == 1);
    check("size_of i16", size_of_t(cast(i16)1) == 2);
    check("size_of u16", size_of_t(cast(u16)1) == 2);
    check("size_of u32", size_of_t(cast(u32)1) == 4);
    check("size_of u64", size_of_t(cast(u64)1) == 8);
    check("size_of f32", size_of_t(cast(f32)1.0) == 4);
    check("size_of bool", size_of_t(true) == 1);
    check("size_of string", size_of_t("abc") == 16);
    check("size_of V2", size_of_t(V2{1.0, 2.0}) == 8);
    check("size_of V3", size_of_t(V3{1.0, 2.0, 3.0}) == 12);
    check("size_of Big", size_of_t(Big{1, 2, 3, 4, 5}) == 40);
    check("size_of Mixed (padding)", size_of_t(Mixed{cast(byte)1, 2, 3.0, true}) == 24);
    check("size_of Nested", size_of_t(Nested{Pair{1, 2}, V2{3.0, 4.0}}) == 16);

    // ---- signedness / width is per instantiation
    check("wrap byte", add(cast(byte)200, cast(byte)100) == cast(byte)44);
    check("wrap i8", add(cast(i8)100, cast(i8)100) == cast(i8)(-56));
    check("sdiv i32", div(cast(i32)(-7), cast(i32)2) == cast(i32)(-3));
    check("udiv u32 (high bit set)", div(cast(u32)4000000000, cast(u32)2) == cast(u32)2000000000);
    check("umod u32 (high bit set)", modulo(cast(u32)4000000001, cast(u32)10) == cast(u32)1);
    check("smod i32", modulo(cast(i32)(-7), cast(i32)3) == cast(i32)(-1));
    check("fdiv f64", div(7.0, 2.0) == 3.5);
    check("idiv i64", div(7, 2) == 3);
    check("lt signed i8", lt(cast(i8)(-1), cast(i8)1));
    check("lt unsigned byte", !lt(cast(byte)255, cast(byte)1));
    check("lt unsigned u32", !lt(cast(u32)4000000000, cast(u32)1));
    check("lt f64", lt(1.5, 2.5));
    check("neg i32", neg(cast(i32)5) == cast(i32)(-5));
    check("neg f64", neg(2.5) == -2.5);
    check("neg of neg", neg(neg(7)) == 7);

    // ---- casts inside generic bodies
    check("to_i64 byte zero-extends", to_i64(cast(byte)200) == 200);
    check("to_i64 i8 sign-extends", to_i64(cast(i8)(-1)) == -1);
    check("to_i64 u32 zero-extends", to_i64(cast(u32)4000000000) == 4000000000);
    check("to_i64 f64 truncs", to_i64(3.9) == 3);
    check("to_i64 f64 neg truncs", to_i64(-3.9) == -3);
    check("to_i64 f32", to_i64(cast(f32)2.5) == 2);
    check("to_f64 i32", to_f64(cast(i32)3) == 3.0);
    check("to_f64 byte unsigned", to_f64(cast(byte)255) == 255.0);
    check("to_f64 i8 signed", to_f64(cast(i8)(-2)) == -2.0);
    check("to_f64 f32", to_f64(cast(f32)1.5) == 1.5);
    check("to_byte from i64", to_byte(300) == cast(byte)44);
    check("to_byte from byte", to_byte(cast(byte)7) == cast(byte)7);

    // ---- type_id(T)
    xi := 9;
    check("tid i64", tid(1) == type_id(i64));
    check("tid i32", tid(cast(i32)1) == type_id(i32));
    check("tid f64", tid(1.0) == type_id(f64));
    check("tid string", tid("s") == type_id(string));
    check("tid distinct", tid(1) != tid(1.0));
    check("tid ptr != pointee", tid(&xi) != tid(xi));

    // ---- generic position / unused generics
    check("second", second(cast(i32)1, 2.5) == 2.5);
    check("second struct", second(cast(i32)1, (Pair{5, 6})).b == 6);
    check("last3", last3(1, "x", 2.5) == 2.5);
    check("first_of_two", first_of_two(7, "x") == 7);
    check("first_of_two string first", len(first_of_two("xyz", 7.5)) == 3);
    check("scale i32", scale(cast(i32)4, 3) == cast(i32)12);
    check("scale f64", scale(1.5, 4) == 6.0);
    check("pick true", pick(true, 1, 2) == 1);
    check("pick false", pick(false, 1.5, 2.5) == 2.5);

    // ---- literal binding with a typed arg
    a32 : i32 = 10;
    b32 : i32 = 4;
    check("add typed + literal", add(a32, 2) == 12);
    check("max2 neg literals", max2(-5, -9) == -5);
    r32 : i32 = add(a32, b32);
    check("assign to i32 var", r32 == 14);
    r64 : i64 = id(5);
    check("assign to i64 var", r64 == 5);
    rf32 : f32 = id(cast(f32)1.5);
    check("assign to f32 var", rf32 == 1.5);

    // ---- generic calls inside expressions
    check("mul of two generic calls", add(1, 2) * add(3, 4) == 21);
    check("cmp of generic calls", id(5) > id(4));
    check("unary on generic call", -id(5) == -5);
    check("generic result as struct field", (Pair{id(cast(i32)1), id(cast(i32)2)}).b == 2);
    check("generic as plain arg", plain_taking(id(41)) == 42);
    check("short-circuit and", !(id(false) && id(true)));
    check("short-circuit or", id(true) || id(false));
    check("generic in parens", (id(1) + id(2)) * id(3) == 9);
    check("deeply nested", id(id(id(id(id(id(id(id(1)))))))) == 1);

    // ---- evaluation count / order
    reset();
    check("arg evaluated once", twice_use(next()) == 2);
    check("arg evaluated once (counter)", counter == 1);
    reset();
    check("left-to-right", gsub(next(), next()) == -1);
    reset();
    bv := bump(5);
    check("body side effect once", bv == 5 && counter == 1);
    reset();
    arr1 := [3]i64{1, 2, 3};
    arr1[id(next()) - 1] += 10;
    check("compound assign index evaluated once", counter == 1 && arr1[0] == 11 && arr1[1] == 2);

    // ---- pointers
    px := &xi;
    check("addr_of/deref", deref(addr_of(px)) == 9);
    check("deref ptr ptr", deref(deref(&px)) == 9);
    store(px, 77);
    check("store through ptr", xi == 77);
    ff1 := 1.5;
    ff2 := 2.5;
    swap(&ff1, &ff2);
    check("swap f64", ff1 == 2.5 && ff2 == 1.5);
    bg1 := Big{1, 2, 3, 4, 5};
    bg2 := Big{6, 7, 8, 9, 10};
    swap(&bg1, &bg2);
    check("swap Big", bg1.a == 6 && bg1.e == 10 && bg2.a == 1 && bg2.e == 5);
    mx1 := Mixed{cast(byte)1, 2, 3.0, true};
    mx2 := Mixed{cast(byte)4, 5, 6.0, false};
    swap(&mx1, &mx2);
    check("swap Mixed", mx1.a == cast(byte)4 && mx1.b == 5 && mx1.c == 6.0 && !mx1.d && mx2.d);
    store(&bg1, Big{0, 0, 0, 0, 99});
    check("store struct", bg1.e == 99 && bg1.a == 0);

    // ---- structs through the ABI (small, medium, big, mixed)
    big := id(Big{1, 2, 3, 4, 5});
    check("id Big", big.a == 1 && big.b == 2 && big.c == 3 && big.d == 4 && big.e == 5);
    v3 := id(V3{1.0, 2.0, 3.0});
    check("id V3", v3.x == 1.0 && v3.y == 2.0 && v3.z == 3.0);
    v2 := id(V2{1.5, 2.5});
    check("id V2", v2.x == 1.5 && v2.y == 2.5);
    mxd := id(Mixed{cast(byte)7, 1234567890123, 2.5, true});
    check("id Mixed", mxd.a == cast(byte)7 && mxd.b == 1234567890123 && mxd.c == 2.5 && mxd.d);
    wr := id(Wrapper{&xi, 3});
    check("id Wrapper", wr.p^ == 77 && wr.n == 3);
    nest := id(Nested{Pair{1, 2}, V2{3.0, 4.0}});
    check("id Nested", nest.pr.b == 2 && nest.v.y == 4.0);
    check("first_of_two Big", first_of_two(Big{1, 2, 3, 4, 5}, V3{1.0, 2.0, 3.0}).e == 5);
    check("second Big", second(cast(i32)0, Big{1, 2, 3, 4, 5}).d == 4);
    check("pick Big", pick(false, Big{1, 1, 1, 1, 1}, Big{2, 2, 2, 2, 2}).c == 2);

    // ---- duck typing
    vv2 := V2{1.0, 2.0};
    vv3 := V3{3.0, 4.0, 5.0};
    ixy := IntXY{2, 3};
    check("dot V2 V2", dot(vv2, vv2) == 5.0);
    check("dot V2 V3 (two different struct types)", dot(vv2, vv3) == 11.0);
    check("dot IntXY IntXY", dot(ixy, ixy) == 13.0);
    check("sum_xy V2", sum_xy(&vv2) == 3.0);
    check("sum_xy IntXY", sum_xy(&ixy) == 5.0);

    // ---- locals of type T
    check("pair_arr_sum i64", pair_arr_sum(1, 2) == 3);
    check("pair_arr_sum f64", pair_arr_sum(1.5, 2.5) == 4.0);
    check("pair_arr_sum i32", pair_arr_sum(a32, b32) == 14);
    check("inc_via_ptr i32", inc_via_ptr(a32) == 11);
    check("inc_via_ptr f64", inc_via_ptr(1.5) == 2.5);
    check("zero_of i8", zero_of(cast(i8)5) == cast(i8)0);
    check("zero_of f32", zero_of(cast(f32)5.0) == 0.0);

    // ---- control flow in generic bodies
    check("clamp lo", clamp(-5, 0, 10) == 0);
    check("clamp hi", clamp(50, 0, 10) == 10);
    check("clamp mid", clamp(5, 0, 10) == 5);
    check("clamp f64", clamp(0.5, 1.0, 2.0) == 1.0);
    check("count_up i64", count_up(5) == 12);
    check("count_up i32", count_up(cast(i32)5) == cast(i32)12);
    check("count_up f64", count_up(5.0) == 12.0);
    check("count_up break", count_up(1000) < 200);
    evens := [5]i64{1, 3, 4, 5, 6};
    check("first_even found", first_even(evens[:]) == 2);
    odds := [3]i32{1, 3, 5};
    check("first_even not found", first_even(odds[:]) == -1);

    // ---- slices
    ints := [4]i64{1, 2, 3, 4};
    f32s := [3]f32{1.5, 2.5, 3.0};
    check("sum i64", sum(ints[:]) == 10);
    check("sum f32", sum(f32s[:]) == 7.0);
    check("sum sub-slice", sum(ints[1:3]) == 5);
    check("sum_rec", sum_rec(ints[:]) == 10);
    check("sum_rec empty", sum_rec(ints[2:2]) == 0);
    check("sum_rec f32", sum_rec(f32s[:]) == 7.0);
    check("take", len(take(ints[:], 2)) == 2);
    check("take then sum", sum(take(ints[:], 3)) == 6);
    check("tail^3", first(tail(tail(tail(ints[:])))) == 4);
    lp := last_ptr(ints[:]);
    check("last_ptr", lp^ == 4);
    lp^ = 40;
    check("last_ptr writes through", ints[3] == 40);
    ints[3] = 4;
    // check("string -> string", first(("Hello")[:]) == cast(byte)72);
    structs := [2]IntXY{IntXY{1, 2}, IntXY{3, 4}};
    check("first of struct slice", first(structs[:]).y == 2);
    check("tail of struct slice", first(tail(structs[:])).x == 3);

    // ---- function typed params
    check("apply named fn", apply(5, double_i64) == 10);
    check("apply lambda calling generic", apply(5, fn(x: i64): i64 => id(x) + 1) == 6);
    check("apply nested apply", apply(1, fn(x: i64): i64 => apply(x, double_i64)) == 2);
    check("compose2", compose2(3, fn(x: i64): i64 => x + 1, fn(x: i64): i64 => x * 10) == 40);
    check("compose2 f64", compose2(1.5, fn(x: f64): f64 => x * 2.0, fn(x: f64): f64 => x + 0.5) == 3.5);
    check("fold sum", fold(ints[:], 0, fn(acc: i64, x: i64): i64 => acc + x) == 10);
    check("fold max", fold(f32s[:], cast(f32)0.0, fn(acc: f32, x: f32): f32 => max2(acc, x)) == 3.0);
    check("count_if", count_if(ints[:], fn(x: i64): bool => x > 2) == 2);
    check("count_if none", count_if(ints[:], fn(x: i64): bool => x > 100) == 0);
    check("call_ptr", call_ptr(&ints[2], read_i64) == 3);
    check("apply struct", apply(Pair{1, 2}, fn(x: Pair): Pair => Pair{x.b, x.a}).a == 2);
    check("apply Big", apply(Big{1, 2, 3, 4, 5}, fn(x: Big): Big => Big{x.e, x.d, x.c, x.b, x.a}).a == 5);

    // ---- chains, recursion, shared instantiations
    check("lvl chain i32", lvl1(cast(i32)5) == cast(i32)5);
    check("lvl chain f64", lvl1(2.5) == 2.5);
    check("lvl chain struct", lvl1(Pair{1, 2}).b == 2);
    check("depth same T", depth(cast(i32)1, 3) == 4);
    check("depth different T", depth(cast(byte)1, 3) == 4);
    check("depth n=0 byte", depth(cast(byte)1, 0) == 1);
    check("depth n=0 f64", depth(1.0, 0) == 8);
    check("uses_id_a", uses_id_a() == 1);
    check("uses_id_b", uses_id_b() == 5);
    check("plain wrapper", plain(3) == 3);
    check("mix8", mix8(1, cast(i32)2, cast(f32)3.0, cast(f32)4.0, cast(byte)5, 6, 7.0, cast(byte)8) == 36.0);
    check("mix8 other types", mix8(1.5, cast(i32)2, cast(byte)3, cast(f32)4.0, cast(i16)5, 6, 7.0, cast(byte)8) == 36.5);

    // ---- mangling
    check("id vs id_i32 user fn", id(cast(i32)1) == cast(i32)1 && id_i32(cast(i32)1) == cast(i32)999);
    check("id vs id__i32 user fn", id__i32(cast(i32)1) == cast(i32)998);

    // ---- many call sites / loops
    total := 0;
    k := 0;
    while k < 1000 {
        total = total + id(k) + add(k, 1) - add(k, 1);
        k = k + 1;
    }
    check("loop 1000 call sites", total == 499500);
    acc := 0;
    for v in ints[:] {
        acc = acc + id(v) + sum(ints[0:1]);
    }
    check("for with generic calls", acc == 14);
    hit := false;
    if id(true) { hit = true; }
    check("generic in if", hit);
    wl := 0;
    while id(wl) < 3 { wl += 1; }
    check("generic in while cond", wl == 3);
    check("generic as index", ints[id(2)] == 3);
    check("generic inside index of generic", ints[add(id(1), id(1))] == 3);

    // ---- declared after use
    check("late generic", late_gen(5) == 5);
    check("late generic f64", late_gen(1.5) == 1.5);
    check("generic -> later plain fn", gen_calls_plain(2) == 21);
    check("generic -> later plain fn (i32)", gen_calls_plain(cast(i32)3) == 31);

    println("all passed");
}

fn late_gen(a: $T): T { return a; }
fn later_plain(x: i64): i64 { return x * 10; }
