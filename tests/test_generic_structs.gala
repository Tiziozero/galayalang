import "core/core.gala";
import "core/mem.gala";

// Generic structs. Passes iff there are no FAIL lines and it prints "all passed".
// Must-fail cases live in neg_generics.txt (see also neg_generic_structs_extra.txt).
// `$T` declares a struct generic once in its field list, `Box(i32)` instantiates it.
// No shadowing: every local in main (and every lambda parameter) has a unique name.
// Sections marked ASSUMPTION depend on language design that may not be settled: delete the
// section if you decide the opposite.

fn check(name: string, ok: bool) {
    if !ok {
        println("FAIL:", name);
    }
}

// ---------------------------------------------------------------- plain structs
struct Pair { a: i32, b: i32 }
struct V2 { x, y: f32 }
struct Big { a, b, c, d, e: i64 }

// ---------------------------------------------------------------- generic structs
struct Box { v: $T, n: i64 }                    // one param, T first, fixed field after it
struct Tup { a: $A, b: $B }                     // two params
struct Twin { a, b: $T }                        // multi-name field shares one generic
struct Tagged { v: $T, flag: bool }             // padding depends on the instance
struct Node { v: $T, next: ^Node(T) }           // self reference through a pointer
struct Tree { v: $T, l, r: ^Tree(T) }
struct Wrap { inner: Box($T), extra: i32 }      // generic struct holding another instance
struct DynArray { items: []$T, length: i64 }    // items.len is the capacity

// non generic struct holding instances
struct Holder { b: Box(i32), t: Tup(i64, f64), p: ^Box(i64) }

// ---------------------------------------------------------------- globals
g_box := Box(i32){5, 6};
g_tup : Tup(i32, f64) = Tup(i32, f64){1, 2.5};
g_calls := 0;

// ---------------------------------------------------------------- helpers
fn size_of_t(a: $T): i64 { return size_of(T); }
fn tid(a: $T): i64 { return type_id(T); }
fn id(a: $T): T { return a; }
fn sum(a: []$T): T {
    total : T = cast(T)0;
    for i in a { total = total + i; }
    return total;
}

// ---------------------------------------------------------------- generic fns over generic structs
fn make_box(v: $T): Box(T) { return Box(T){v, 0}; }
fn make_box_n(v: $T, n: i64): Box(T) { return Box(T){v, n}; }
fn unbox(b: Box($T)): T { return b.v; }
fn box_n(b: Box($T)): i64 { return b.n; }
fn put(b: ^Box($T), v: T) { b^.v = v; }
fn bump(b: ^Box($T)) { b^.n += 1; }
fn with_v(b: Box($T), v: T): Box(T) { return Box(T){v, b.n}; }
fn box_swap(a: ^Box($T), b: ^Box(T)) {
    tmp : Box(T) = a^;
    a^ = b^;
    b^ = tmp;
}
fn map_box(b: Box($T), f: fn(mx: T): T): Box(T) { return Box(T){f(b.v), b.n}; }
fn apply_box(b: Box($T), f: fn(ax: Box(T)): Box(T)): Box(T) { return f(b); }
fn wrap2(a: $T): Box(Box(T)) { return Box(Box(T)){Box(T){a, 1}, 2}; }
fn unbox2(b: Box(Box($T))): T { return b.v.v; }
fn addr_of(p: ^Box($T)): ^Box(T) { return p; }
fn next_ptr(p: ^Box($T)): ^Box(T) {
    g_calls += 1;
    return p;
}
fn get_n(p: ^$T): i64 { return p^.n; }          // duck typing on a field, any instance works

fn first_of(p: Tup($A, $B)): A { return p.a; }
fn second_of(p: Tup($A, $B)): B { return p.b; }
fn make_tup(a: $A, b: $B): Tup(A, B) { return Tup(A, B){a, b}; }
fn tup_swap(p: Tup($A, $B)): Tup(B, A) { return Tup(B, A){p.b, p.a}; }
fn twin_sum(t: Twin($T)): T { return t.a + t.b; }
fn twin_of(a: $T, b: T): Twin(T) { return Twin(T){a, b}; }

fn box_sum(a: []Box($T)): T {
    total : T = cast(T)0;
    for i in a { total = total + i.v; }
    return total;
}
fn boxes_n(a: []Box($T)): i64 {
    total := 0;
    for i in a { total += i.n; }
    return total;
}
fn box_first(a: []Box($T)): Box(T) { return a[0]; }

fn list_len(p: ^Node($T)): i64 {
    count := 0;
    cur := p;
    while cur != 0 {
        count += 1;
        cur = cur^.next;
    }
    return count;
}
fn list_sum(p: ^Node($T)): T {
    total : T = cast(T)0;
    cur := p;
    while cur != 0 {
        total = total + cur^.v;
        cur = cur^.next;
    }
    return total;
}
fn tree_sum(t: ^Tree($T)): T {
    if t == 0 { return cast(T)0; }
    return t^.v + tree_sum(t^.l) + tree_sum(t^.r);
}
fn wrap_val(w: Wrap($T)): T { return w.inner.v; }

// ---------------------------------------------------------------- non generic fns using instances
fn take_i32(b: Box(i32)): i32 { return b.v; }
fn make_i32(v: i32): Box(i32) { return Box(i32){v, 7}; }

// ABI: small, mixed, SSE, and memory class instances by value, in and out
fn mk_ii(a: i32, b: i32): Tup(i32, i32) { return Tup(i32, i32){a, b}; }
fn sum_ii(t: Tup(i32, i32)): i32 { return t.a + t.b; }
fn mk_ff(a: f32, b: f32): Tup(f32, f32) { return Tup(f32, f32){a, b}; }
fn sum_ff(t: Tup(f32, f32)): f32 { return t.a + t.b; }
fn mk_dd(a: f64, b: f64): Tup(f64, f64) { return Tup(f64, f64){a, b}; }
fn sum_dd(t: Tup(f64, f64)): f64 { return t.a + t.b; }
fn mk_di(a: f64, b: i64): Tup(f64, i64) { return Tup(f64, i64){a, b}; }
fn sum_di(t: Tup(f64, i64)): f64 { return t.a + cast(f64)t.b; }
fn mk_bb(a: byte, b: byte): Tup(byte, byte) { return Tup(byte, byte){a, b}; }
fn sum_bb(t: Tup(byte, byte)): i64 { return cast(i64)t.a + cast(i64)t.b; }
fn mk_bigbox(b: Big): Box(Big) { return Box(Big){b, 100}; }
fn sum_bigbox(b: Box(Big)): i64 { return b.v.a + b.v.b + b.v.c + b.v.d + b.v.e + b.n; }
fn box_f64_inc(b: Box(f64)): Box(f64) { return Box(f64){b.v + 1.0, b.n + 1}; }
fn box_f32_inc(b: Box(f32)): Box(f32) { return Box(f32){b.v + cast(f32)1.0, b.n + 1}; }

// ---------------------------------------------------------------- DynArray
fn dyn_make(cap: i64, fill: $T): DynArray(T) {
    return DynArray(T){make_slice::<T>(cap), 0};
}

fn dyn_push(a: ^DynArray($T), v: T) {
    if a^.length == len(a^.items) {
        new_cap := len(a^.items) * 2;
        if new_cap == 0 { new_cap = 4; }
        bigger := make_slice::<T>(new_cap);
        i := 0;
        while i < a^.length {
            bigger[i] = a^.items[i];
            i += 1;
        }
        a^.items = bigger;
    }
    a^.items[a^.length] = v;
    a^.length += 1;
}

fn dyn_get(a: ^DynArray($T), idx: i64): T { return a^.items[idx]; }
fn dyn_slice(a: ^DynArray($T)): []T { return a^.items[0:a^.length]; }

// generic calling generic with the same instance threaded through
fn push_many(a: ^DynArray($T), v: T, count: i64) {
    k := 0;
    while k < count {
        dyn_push(a, v);
        k += 1;
    }
}

// ---------------------------------------------------------------- ASSUMPTION helpers
// (see the ASSUMPTION sections at the end of main)

// instances may be used before the struct is declared
struct UsesLate { l: Late(i32), x: i32 }
struct Late { v: $T, n: i64 }
fn late_val(l: Late($T)): T { return l.v; }

// mutually recursive generic structs, through pointers
struct Ping { v: $T, other: ^Pong(T) }
struct Pong { v: $T, other: ^Ping(T) }

// variadic over a generic struct
fn vbox_sum(data: ..Box($T)): T {
    total : T = cast(T)0;
    for i in data { total = total + i.v; }
    return total;
}

fn count_any(xs: ..any): i64 { return len(xs); }

fn main() {
    // ---------------------------------------------------------------- one struct, many instances
    b_i32 := Box(i32){7, 1};
    b_i64 := Box(i64){70, 2};
    b_f64 := Box(f64){2.5, 3};
    b_f32 := Box(f32){cast(f32)1.5, 4};
    b_byte := Box(byte){cast(byte)200, 5};
    b_bool := Box(bool){true, 6};
    b_str := Box(string){"hello", 7};
    b_pair := Box(Pair){Pair{1, 2}, 8};
    pv := 99;
    b_ptr := Box(^i64){&pv, 9};
    arr_s := [3]i64{1, 2, 3};
    b_sl := Box([]i64){arr_s[:], 10};
    b_arr := Box([3]i32){[3]i32{4, 5, 6}, 11};
    b_big := Box(Big){Big{1, 2, 3, 4, 5}, 12};

    check("i32 fields", b_i32.v == 7 && b_i32.n == 1);
    check("i64 fields", b_i64.v == 70 && b_i64.n == 2);
    check("f64 fields", b_f64.v == 2.5 && b_f64.n == 3);
    check("f32 fields", b_f32.v == cast(f32)1.5 && b_f32.n == 4);
    check("byte fields", b_byte.v == cast(byte)200 && b_byte.n == 5);
    check("bool fields", b_bool.v == true && b_bool.n == 6);
    check("string field", len(b_str.v) == 5 && b_str.n == 7);
    check("struct field", b_pair.v.a == 1 && b_pair.v.b == 2 && b_pair.n == 8);
    check("pointer field", b_ptr.v^ == 99 && b_ptr.n == 9);
    check("slice field", len(b_sl.v) == 3 && b_sl.v[2] == 3 && b_sl.n == 10);
    check("array field", b_arr.v[1] == 5 && b_arr.v[2] == 6 && b_arr.n == 11);
    check("big struct field", b_big.v.a == 1 && b_big.v.e == 5 && b_big.n == 12);

    // named literal members
    b_named := Box(i32){v = 3, n = 9};
    check("named literal", b_named.v == 3 && b_named.n == 9);

    // member writes, compound writes, writes through nested members
    b_i32.v = 8;
    b_i32.v += 1;
    b_i32.n *= 5;
    check("member assign", b_i32.v == 9 && b_i32.n == 5);
    b_pair.v.b = 50;
    b_pair.v.a += 10;
    check("nested member assign", b_pair.v.a == 11 && b_pair.v.b == 50);
    b_arr.v[0] = 40;
    check("array member element assign", b_arr.v[0] == 40 && b_arr.v[1] == 5);
    b_ptr.v^ = 100;
    check("write through pointer member", pv == 100);
    b_sl.v[1] = 20;
    check("slice member aliases the array", arr_s[1] == 20);

    // structs are values
    cp_a := Box(i64){1, 2};
    cp_b := cp_a;
    cp_b.v = 9;
    check("copy is independent", cp_a.v == 1 && cp_b.v == 9);
    check("copy keeps other member", cp_b.n == 2);

    // ---------------------------------------------------------------- sizes and layout per instance
    check("size_of Box(i32)", size_of_t(b_i32) == 16);
    check("size_of Box(i64)", size_of_t(b_i64) == 16);
    check("size_of Box(byte)", size_of_t(b_byte) == 16);
    check("size_of Box(f64)", size_of_t(b_f64) == 16);
    check("size_of Box(Pair)", size_of_t(b_pair) == 16);
    check("size_of Box(Big)", size_of_t(b_big) == 48);
    check("size_of Box([3]i32)", size_of_t(b_arr) == 24);
    check("size_of Box([]i64)", size_of_t(b_sl) == 24);

    // padding is computed per instance, not once for the struct
    check("size_of Tagged(byte)", size_of_t(Tagged(byte){cast(byte)1, true}) == 2);
    check("size_of Tagged(bool)", size_of_t(Tagged(bool){true, true}) == 2);
    check("size_of Tagged(i32)", size_of_t(Tagged(i32){1, true}) == 8);
    check("size_of Tagged(f32)", size_of_t(Tagged(f32){cast(f32)1.0, true}) == 8);
    check("size_of Tagged(i64)", size_of_t(Tagged(i64){1, true}) == 16);
    check("size_of Tagged(Pair)", size_of_t(Tagged(Pair){Pair{1, 2}, true}) == 12);
    check("size_of Tagged(V2)", size_of_t(Tagged(V2){V2{1.0, 2.0}, true}) == 12);
    check("size_of Tagged(Big)", size_of_t(Tagged(Big){Big{1, 2, 3, 4, 5}, true}) == 48);

    check("size_of Tup(i32, i32)", size_of_t(Tup(i32, i32){1, 2}) == 8);
    check("size_of Tup(i32, f64)", size_of_t(Tup(i32, f64){1, 2.5}) == 16);
    check("size_of Tup(byte, byte)", size_of_t(Tup(byte, byte){cast(byte)1, cast(byte)2}) == 2);
    check("size_of Tup(i32, byte)", size_of_t(Tup(i32, byte){1, cast(byte)2}) == 8);
    check("size_of Tup(i64, byte)", size_of_t(Tup(i64, byte){1, cast(byte)2}) == 16);
    check("size_of Tup(f32, f32)", size_of_t(Tup(f32, f32){cast(f32)1.0, cast(f32)2.0}) == 8);
    check("size_of Twin(i32)", size_of_t(Twin(i32){1, 2}) == 8);
    check("size_of Twin(byte)", size_of_t(Twin(byte){cast(byte)1, cast(byte)2}) == 2);
    check("size_of Twin(f64)", size_of_t(Twin(f64){1.0, 2.0}) == 16);
    check("size_of Node(i64)", size_of_t(Node(i64){1, 0}) == 16);
    check("size_of Node(byte)", size_of_t(Node(byte){cast(byte)1, 0}) == 16);
    check("size_of Tree(i32)", size_of_t(Tree(i32){1, 0, 0}) == 24);
    check("size_of Wrap(i32)", size_of_t(Wrap(i32){Box(i32){1, 2}, 3}) == 24);
    check("size_of nested Box(Box(i32))", size_of_t(Box(Box(i32)){Box(i32){1, 2}, 3}) == 24);

    // ---------------------------------------------------------------- type identity
    check("same instance, same type id", tid(b_i32) == tid(Box(i32){1, 2}));
    check("different args, different type id", tid(b_i32) != tid(b_i64));
    check("Box(i32) vs Box(f32)", tid(b_i32) != tid(Box(f32){cast(f32)1.0, 0}));
    check("Box(i64) vs Box(Box(i64))", tid(b_i64) != tid(Box(Box(i64)){b_i64, 0}));
    check("Box(i32) vs plain struct", tid(b_i32) != tid(Pair{1, 2}));
    check("arg order matters", tid(Tup(i32, f64){1, 2.5}) != tid(Tup(f64, i32){2.5, 1}));
    check("different generic structs", tid(Box(i64){1, 2}) != tid(Twin(i64){1, 2}));
    check("same Tup instance", tid(Tup(i32, f64){1, 2.5}) == tid(g_tup));
    check("result of generic fn is the same instance",
          tid(make_box(cast(i32)1)) == tid(Box(i32){0, 0}));
    check("nested instance identity", tid(wrap2(cast(i32)1)) == tid(Box(Box(i32)){Box(i32){1, 1}, 2}));

    // ---------------------------------------------------------------- generic fns over instances
    check("unbox i32", unbox(b_i32) == 9);
    check("unbox i32 size", size_of_t(unbox(b_i32)) == 4);
    check("unbox i64 size", size_of_t(unbox(b_i64)) == 8);
    check("unbox f64", unbox(b_f64) == 2.5);
    check("unbox byte size", size_of_t(unbox(b_byte)) == 1);
    check("unbox string", len(unbox(b_str)) == 5);
    check("unbox struct", unbox(b_pair).a == 11);
    check("unbox keeps n", box_n(b_i64) == 2);

    check("make_box i64", unbox(make_box(5)) == 5 && box_n(make_box(5)) == 0);
    check("make_box f64", make_box(2.5).v == 2.5);
    check("make_box i32 size", size_of_t(unbox(make_box(cast(i32)3))) == 4);
    check("make_box_n", make_box_n(cast(i32)3, 77).n == 77);
    bx_made : Box(i32) = make_box(cast(i32)3);
    check("make_box into declared type", bx_made.v == 3);
    bx_made2 : Box(i32) = make_i32(8);
    check("non generic fn into declared type", bx_made2.v == 8 && bx_made2.n == 7);
    check("non generic param", take_i32(make_box(cast(i32)4)) == 4);
    check("non generic param from literal", take_i32(Box(i32){5, 6}) == 5);

    // T bound by the struct, the plain argument adapts to it
    put(&b_i32, 42);
    check("put literal adapts to i32", b_i32.v == 42);
    put(&b_f64, 9.5);
    check("put f64", b_f64.v == 9.5);
    put(&b_pair, Pair{3, 4});
    check("put struct", b_pair.v.a == 3 && b_pair.v.b == 4);
    bump(&b_i32);
    bump(&b_i32);
    check("bump through pointer", b_i32.n == 7);
    wv := with_v(b_i64, 123);
    check("with_v returns new box", wv.v == 123 && wv.n == 2 && b_i64.v == 70);

    sw_a := Box(i64){1, 10};
    sw_b := Box(i64){2, 20};
    box_swap(&sw_a, &sw_b);
    check("box_swap i64", sw_a.v == 2 && sw_a.n == 20 && sw_b.v == 1 && sw_b.n == 10);
    sw_c := Box(Pair){Pair{1, 2}, 3};
    sw_d := Box(Pair){Pair{4, 5}, 6};
    box_swap(&sw_c, &sw_d);
    check("box_swap struct", sw_c.v.a == 4 && sw_d.v.b == 2 && sw_c.n == 6);

    check("map_box", map_box(Box(i64){5, 1}, fn(m1: i64): i64 => m1 * 3).v == 15);
    check("map_box keeps n", map_box(Box(i64){5, 1}, fn(m2: i64): i64 => m2 * 3).n == 1);
    check("map_box f64", map_box(Box(f64){1.5, 0}, fn(m3: f64): f64 => m3 + 1.0).v == 2.5);
    check("apply_box", apply_box(Box(i32){1, 2},
          fn(m4: Box(i32)): Box(i32) => Box(i32){m4.v + 1, m4.n * 10}).n == 20);

    // nesting
    bb := wrap2(cast(i32)4);
    check("wrap2 shape", bb.v.v == 4 && bb.v.n == 1 && bb.n == 2);
    check("unbox2", unbox2(bb) == 4);
    check("unbox2 size", size_of_t(unbox2(bb)) == 4);
    check("unbox(unbox)", unbox(unbox(bb)) == 4);
    check("unbox2 f64", unbox2(wrap2(2.5)) == 2.5);
    check("triple nesting", unbox(unbox(unbox(Box(Box(Box(i64))){Box(Box(i64)){Box(i64){7, 1}, 2}, 3}))) == 7);

    // untouched generic fn versions for different instances must not mix
    check("id per instance 1", id(b_i32).v == 42);
    check("id per instance 2", id(b_f64).v == 9.5);
    check("id per instance 3", id(b_big).v.e == 5);
    check("size_of_t(id(Box(i32)))", size_of_t(id(b_i32)) == 16);
    check("duck typing on a member, Box(i32)", get_n(&b_i32) == 7);
    check("duck typing on a member, Box(f64)", get_n(&b_f64) == 3);
    check("duck typing on a member, Box(Big)", get_n(&b_big) == 12);

    // ---------------------------------------------------------------- several type params
    tp_a := Tup(i32, f64){1, 2.5};
    check("Tup fields", tp_a.a == 1 && tp_a.b == 2.5);
    check("first_of", first_of(tp_a) == 1);
    check("first_of size", size_of_t(first_of(tp_a)) == 4);
    check("second_of", second_of(tp_a) == 2.5);
    check("second_of size", size_of_t(second_of(tp_a)) == 8);
    tp_sw := tup_swap(tp_a);
    check("tup_swap", tp_sw.a == 2.5 && tp_sw.b == 1);
    check("tup_swap sizes", size_of_t(tp_sw.a) == 8 && size_of_t(tp_sw.b) == 4);
    check("tup_swap twice", tup_swap(tp_sw).a == 1);
    check("make_tup", first_of(make_tup(cast(i32)1, 2.5)) == 1 && second_of(make_tup(cast(i32)1, 2.5)) == 2.5);
    check("make_tup same types", first_of(make_tup(1, 2)) == 1 && second_of(make_tup(1, 2)) == 2);
    check("make_tup byte byte", size_of_t(make_tup(cast(byte)1, cast(byte)2)) == 2);
    tp_nest := make_tup(Box(i32){1, 2}, Tup(byte, i64){cast(byte)3, 4});
    check("Tup of instances", tp_nest.a.n == 2 && tp_nest.b.b == 4 && tp_nest.b.a == cast(byte)3);
    check("Tup of instances, first_of", first_of(tp_nest).v == 1);
    check("Tup of instances, second_of", second_of(tp_nest).b == 4);

    check("Twin fields", (Twin(i32){3, 4}).a == 3);
    check("twin_sum i32", twin_sum(Twin(i32){3, 4}) == 7);
    check("twin_sum f64", twin_sum(twin_of(1.5, 2.5)) == 4.0);
    check("twin_of typed", size_of_t(twin_of(cast(i32)1, 2).a) == 4);

    // ---------------------------------------------------------------- pointers and recursive structs
    n_c := Node(i64){3, 0};
    n_b := Node(i64){2, &n_c};
    n_a := Node(i64){1, &n_b};
    check("list_len", list_len(&n_a) == 3);
    check("list_sum", list_sum(&n_a) == 6);
    check("walk next", n_a.next^.next^.v == 3);
    check("end of list", n_c.next == 0);
    n_b.v = 20;
    check("list sees edits", list_sum(&n_a) == 24);
    nf_b := Node(f64){2.5, 0};
    nf_a := Node(f64){1.5, &nf_b};
    check("list_sum f64", list_sum(&nf_a) == 4.0);
    check("list_len f64", list_len(&nf_a) == 2);
    check("list_len one node", list_len(&nf_b) == 1);

    t_l := Tree(i32){1, 0, 0};
    t_r := Tree(i32){2, 0, 0};
    t_root := Tree(i32){10, &t_l, &t_r};
    check("tree_sum", tree_sum(&t_root) == 13);
    t_root.l^.v = 5;
    check("tree edit through child pointer", tree_sum(&t_root) == 17);
    check("tree_sum leaf", tree_sum(&t_l) == 5);
    t_nil : ^Tree(i32) = 0;
    check("tree_sum null", tree_sum(t_nil) == 0);

    bp_val := Box(i64){1, 2};
    bp := &bp_val;
    bp^.v = 11;
    check("pointer to instance", bp^.v == 11 && bp_val.v == 11);
    bp_pp := &bp;
    check("pointer to pointer to instance", bp_pp^^.n == 2);
    check("addr_of", addr_of(&bp_val)^.v == 11);
    check("pointer is a pointer", size_of_t(bp) == 8);

    // compound assignment whose target contains a call: the call runs exactly once
    ca_box := Box(i64){1, 10};
    addr_of(&ca_box)^.v += 2;
    check("compound assign through call", ca_box.v == 3);
    next_ptr(&ca_box)^.n += 5;
    check("compound assign target evaluated once", ca_box.n == 15 && g_calls == 1);
    next_ptr(&ca_box)^.n = 1;
    check("assign through call", ca_box.n == 1 && g_calls == 2);

    // ---------------------------------------------------------------- instances inside other structs
    h_box := Box(i64){70, 2};
    h := Holder{Box(i32){1, 2}, Tup(i64, f64){3, 4.5}, &h_box};
    check("Holder fields", h.b.v == 1 && h.b.n == 2 && h.t.a == 3 && h.t.b == 4.5);
    check("Holder pointer", h.p^.v == 70);
    check("size_of Holder", size_of_t(h) == 40);
    h.b.v = 11;
    h.t.a += 1;
    h.p^.n = 99;
    check("Holder writes", h.b.v == 11 && h.t.a == 4 && h_box.n == 99);
    check("Holder member into generic fn", unbox(h.b) == 11);
    check("Holder member Tup into generic fn", first_of(h.t) == 4);

    w_i64 := Wrap(i64){Box(i64){5, 6}, 7};
    check("Wrap fields", w_i64.inner.v == 5 && w_i64.inner.n == 6 && w_i64.extra == 7);
    check("wrap_val", wrap_val(w_i64) == 5);
    check("wrap_val f64", wrap_val(Wrap(f64){Box(f64){1.5, 1}, 2}) == 1.5);
    w_i64.inner.v = 55;
    check("Wrap nested write", w_i64.inner.v == 55);
    check("Wrap inner into generic fn", unbox(w_i64.inner) == 55);

    // ---------------------------------------------------------------- arrays and slices of instances
    arr_b := [3]Box(i32){Box(i32){1, 10}, Box(i32){2, 20}, Box(i32){3, 30}};
    check("array of instances", arr_b[1].v == 2 && arr_b[2].n == 30);
    arr_b[1].v = 22;
    check("write array element member", arr_b[1].v == 22);
    check("box_sum", box_sum(arr_b[:]) == 26);
    check("box_sum size", size_of_t(box_sum(arr_b[:])) == 4);
    check("boxes_n", boxes_n(arr_b[:]) == 60);
    check("box_first", box_first(arr_b[:]).n == 10);
    check("box_first tail", box_first(arr_b[1:]).v == 22);
    check("sum of members through for", unbox(box_first(arr_b[2:])) == 3);
    arr_f := [2]Box(f64){Box(f64){1.5, 1}, Box(f64){2.5, 2}};
    check("box_sum f64", box_sum(arr_f[:]) == 4.0);
    check("boxes_n f64", boxes_n(arr_f[:]) == 3);
    check("empty slice of instances", box_sum(arr_b[0:0]) == 0 && boxes_n(arr_b[0:0]) == 0);
    acc := 0;
    for item in arr_b[:] {
        acc += item.n;
    }
    check("for over instances", acc == 60);
    s_b := arr_b[:];
    check("slice len", len(s_b) == 3);
    s_b[0] = Box(i32){100, 200};
    check("write through slice aliases array", arr_b[0].v == 100 && arr_b[0].n == 200);

    // ---------------------------------------------------------------- ABI, by value in and out
    check("ii", sum_ii(mk_ii(3, 4)) == 7);
    check("ii fields", mk_ii(3, 4).b == 4);
    check("ff", sum_ff(mk_ff(cast(f32)1.5, cast(f32)2.0)) == cast(f32)3.5);
    check("dd", sum_dd(mk_dd(1.5, 2.25)) == 3.75);
    check("di (SSE + INTEGER)", sum_di(mk_di(1.5, 4)) == 5.5);
    check("bb", sum_bb(mk_bb(cast(byte)100, cast(byte)50)) == 150);
    check("bigbox (memory class)", sum_bigbox(mk_bigbox(Big{1, 2, 3, 4, 5})) == 115);
    check("bigbox through id", sum_bigbox(id(mk_bigbox(Big{1, 2, 3, 4, 5}))) == 115);
    check("bigbox through unbox", unbox(mk_bigbox(Big{1, 2, 3, 4, 5})).e == 5);
    check("box f64 in/out", box_f64_inc(Box(f64){1.5, 1}).v == 2.5);
    check("box f64 in/out n", box_f64_inc(Box(f64){1.5, 1}).n == 2);
    check("box f32 in/out", box_f32_inc(Box(f32){cast(f32)1.5, 1}).v == cast(f32)2.5);
    check("box f64 twice", box_f64_inc(box_f64_inc(Box(f64){0.5, 0})).v == 2.5);
    check("ii through id", sum_ii(id(mk_ii(1, 2))) == 3);
    check("dd through id", sum_dd(id(mk_dd(1.0, 2.0))) == 3.0);
    check("di through first_of", first_of(mk_di(1.5, 4)) == 1.5);
    check("di through second_of", second_of(mk_di(1.5, 4)) == 4);
    check("bb through tup_swap", tup_swap(mk_bb(cast(byte)1, cast(byte)2)).a == cast(byte)2);

    // ---------------------------------------------------------------- globals
    check("global init literal", g_box.v == 5 && g_box.n == 6);
    check("global typed init", g_tup.a == 1 && g_tup.b == 2.5);
    g_box.v = 50;
    g_box.n += 1;
    check("global member writes", g_box.v == 50 && g_box.n == 7);
    bump(&g_box);
    check("global through generic fn", g_box.n == 8 && unbox(g_box) == 50);
    check("global size", size_of_t(g_box) == 16 && size_of_t(g_tup) == 16);
    g_made := make_box(cast(i64)9);
    check("local from generic fn", g_made.v == 9);

    // ---------------------------------------------------------------- DynArray
    da := dyn_make(0, 0);
    check("dyn empty", da.length == 0 && len(da.items) == 0);
    idx := 0;
    while idx < 100 {
        dyn_push(&da, idx * 2);
        idx += 1;
    }
    check("dyn length", da.length == 100);
    check("dyn capacity", len(da.items) == 128);
    check("dyn_get first", dyn_get(&da, 0) == 0);
    check("dyn_get middle", dyn_get(&da, 50) == 100);
    check("dyn_get last", dyn_get(&da, 99) == 198);
    ds := dyn_slice(&da);
    check("dyn_slice len", len(ds) == 100);
    check("dyn_slice elements", ds[10] == 20 && ds[99] == 198);
    check("sum of dyn_slice", sum(ds) == 9900);
    check("dyn element size", size_of_t(dyn_get(&da, 1)) == 8);
    check("size_of DynArray(i64)", size_of_t(da) == 24);

    da_cap := dyn_make(4, 0);
    check("dyn given capacity", da_cap.length == 0 && len(da_cap.items) == 4);
    dyn_push(&da_cap, 1);
    dyn_push(&da_cap, 2);
    dyn_push(&da_cap, 3);
    dyn_push(&da_cap, 4);
    check("dyn full, no growth", da_cap.length == 4 && len(da_cap.items) == 4);
    dyn_push(&da_cap, 5);
    check("dyn grows by doubling", da_cap.length == 5 && len(da_cap.items) == 8);
    check("dyn keeps old elements", dyn_get(&da_cap, 0) == 1 && dyn_get(&da_cap, 3) == 4 && dyn_get(&da_cap, 4) == 5);
    check("dyn independent of the other array", da.length == 100);

    // T from the struct, the plain argument adapts
    da_32 := dyn_make(1, cast(i32)0);
    dyn_push(&da_32, 5);
    dyn_push(&da_32, 6);
    dyn_push(&da_32, 7);
    check("dyn i32 literals adapt", dyn_get(&da_32, 0) == 5 && dyn_get(&da_32, 2) == 7);
    check("dyn i32 element size", size_of_t(dyn_get(&da_32, 0)) == 4);
    check("dyn i32 growth 1 -> 2 -> 4", da_32.length == 3 && len(da_32.items) == 4);
    check("sum of dyn i32", sum(dyn_slice(&da_32)) == 18);

    da_f := dyn_make(2, 0.0);
    dyn_push(&da_f, 1.5);
    dyn_push(&da_f, 2.5);
    dyn_push(&da_f, 3.5);
    check("dyn f64", da_f.length == 3 && len(da_f.items) == 4);
    check("dyn f64 values", dyn_get(&da_f, 2) == 3.5);
    check("sum of dyn f64", sum(dyn_slice(&da_f)) == 7.5);

    da_p := dyn_make(0, Pair{0, 0});
    pk := 0;
    while pk < 10 {
        dyn_push(&da_p, Pair{cast(i32)pk, cast(i32)(pk * pk)});
        pk += 1;
    }
    check("dyn struct elements", da_p.length == 10 && dyn_get(&da_p, 7).b == 49);
    check("dyn struct growth", len(da_p.items) == 16);
    dyn_slice(&da_p)[3].a = 300;
    check("dyn_slice aliases storage", dyn_get(&da_p, 3).a == 300);

    // a DynArray of generic struct instances
    da_b := dyn_make(0, Box(i32){0, 0});
    bk := 0;
    while bk < 20 {
        dyn_push(&da_b, Box(i32){cast(i32)bk, bk * 3});
        bk += 1;
    }
    check("dyn of Box(i32)", da_b.length == 20 && len(da_b.items) == 32);
    check("dyn of Box(i32) elements", dyn_get(&da_b, 13).v == 13 && dyn_get(&da_b, 13).n == 39);
    check("dyn of Box(i32) through box_sum", box_sum(dyn_slice(&da_b)) == 190);
    check("dyn of Box(i32) through boxes_n", boxes_n(dyn_slice(&da_b)) == 570);
    check("dyn element is the instance", size_of_t(dyn_get(&da_b, 0)) == 16);
    check("dyn of Box(i32) type id", tid(dyn_get(&da_b, 0)) == tid(Box(i32){0, 0}));
    check("size_of DynArray(Box(i32))", size_of_t(da_b) == 24);

    // a DynArray of DynArrays
    outer := dyn_make(0, dyn_make(0, 0));
    inner_a := dyn_make(0, 0);
    dyn_push(&inner_a, 1);
    dyn_push(&inner_a, 2);
    inner_b := dyn_make(0, 0);
    dyn_push(&inner_b, 10);
    dyn_push(&outer, inner_a);
    dyn_push(&outer, inner_b);
    dyn_push(&outer, inner_a);
    check("dyn of dyn length", outer.length == 3);
    check("dyn of dyn inner length", dyn_get(&outer, 0).length == 2 && dyn_get(&outer, 1).length == 1);
    check("dyn of dyn inner element", dyn_get(&outer, 0).items[1] == 2 && dyn_get(&outer, 1).items[0] == 10);
    check("dyn of dyn element type", size_of_t(dyn_get(&outer, 0)) == 24);
    check("dyn of dyn inner sum", sum(dyn_slice(&inner_a)) == 3);

    // a DynArray inside another generic struct, and a Box of a DynArray
    box_of_dyn := Box(DynArray(i64)){da_cap, 7};
    check("Box of DynArray", box_of_dyn.v.length == 5 && box_of_dyn.n == 7);
    check("Box of DynArray element", dyn_get(&box_of_dyn.v, 4) == 5);
    dyn_push(&box_of_dyn.v, 6);
    check("push into DynArray inside a Box", box_of_dyn.v.length == 6 && dyn_get(&box_of_dyn.v, 5) == 6);
    check("original DynArray header unchanged", da_cap.length == 5);

    // generic calling generic, same instance threaded through
    da_many := dyn_make(0, cast(i32)0);
    push_many(&da_many, 7, 10);
    check("push_many length", da_many.length == 10);
    check("push_many values", sum(dyn_slice(&da_many)) == 70);
    da_many_b := dyn_make(0, Box(i64){0, 0});
    push_many(&da_many_b, Box(i64){2, 3}, 6);
    check("push_many Box(i64)", da_many_b.length == 6 && box_sum(dyn_slice(&da_many_b)) == 12);

    // ---------------------------------------------------------------- ASSUMPTION: named members in any order
    // Named members may be given in any order.
    b_reordered := Box(i32){n = 9, v = 3};
    check("named literal reordered", b_reordered.v == 3 && b_reordered.n == 9);

    // ---------------------------------------------------------------- ASSUMPTION: declared later in the file
    ul := UsesLate{Late(i32){4, 5}, 6};
    check("instance of a struct declared later", ul.l.v == 4 && ul.l.n == 5 && ul.x == 6);
    check("generic fn over a struct declared later", late_val(ul.l) == 4);
    check("generic fn over a struct declared later, size", size_of_t(late_val(ul.l)) == 4);

    // ---------------------------------------------------------------- ASSUMPTION: mutually recursive generic structs
    pg := Pong(i64){2, 0};
    pn := Ping(i64){1, &pg};
    pg.other = &pn;
    check("mutual recursion", pn.other^.v == 2 && pn.other^.other^.v == 1);
    check("mutual recursion, three hops", pn.other^.other^.other^.v == 2);

    // ---------------------------------------------------------------- ASSUMPTION: variadics over a generic struct
    check("vbox_sum i64", vbox_sum(Box(i64){1, 0}, Box(i64){2, 0}, Box(i64){3, 0}) == 6);
    check("vbox_sum typed", size_of_t(vbox_sum(Box(i32){1, 0}, Box(i32){2, 0})) == 4);
    check("vbox_sum single", vbox_sum(Box(f64){1.5, 0}) == 1.5);

    // ---------------------------------------------------------------- ASSUMPTION: any holds instances
    check("any count", count_any(Box(i32){1, 2}, Tup(i32, f64){1, 2.5}, Pair{1, 2}) == 3);
    check("any single instance", count_any(b_i64) == 1);

    // ---------------------------------------------------------------- ASSUMPTION: function pointers over instances
    fp_take: fn(fb: Box(i32)): i32 = take_i32;
    check("fn pointer taking an instance", fp_take(Box(i32){5, 6}) == 5);
    fp_make: fn(fv: i32): Box(i32) = make_i32;
    check("fn pointer returning an instance", fp_make(8).n == 7);
    fp_lit := fn(fq: Box(i64)): Box(i64) => Box(i64){fq.v * 2, fq.n};
    check("fn literal over an instance", fp_lit(Box(i64){4, 1}).v == 8);

    println("all passed");
}
