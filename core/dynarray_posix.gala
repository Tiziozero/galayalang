// dynarray.gala
//
// Growable array. `items.len` is the capacity, `length` is the element count.
// T is bound by the struct, so plain literals adapt:
//   da := dyn_make(0, cast(i32)0);  dyn_push(&da, 5);
// The `like` value only exists so T can be inferred (same trick as make_slice).

import "./core_posix.gala";
import "./mem_posix.gala";

struct DynArray {
    items: []$T,
    length: i64,
    allocator: Allocator,
}

fn dyn_make::<$T>(cap: i64, a: Allocator = base_allocator): DynArray(T) {
    return DynArray(T){make_slice::<T>(cap, a), 0, a};
}

fn dyn_cap(a: ^DynArray($T)): i64 { return len(a^.items); }

// View of the live elements. Invalidated by anything that grows the array.
fn dyn_slice(a: ^DynArray($T)): []T { return a^.items[0:a^.length]; }

// No bounds checks: the caller guarantees 0 <= idx < length.
fn dyn_get(a: ^DynArray($T), idx: i64): T { return a^.items[idx]; }
fn dyn_set(a: ^DynArray($T), idx: i64, v: T) { a^.items[idx] = v; }
fn dyn_last(a: ^DynArray($T)): T { return a^.items[a^.length - 1]; }
fn dyn_clear(a: ^DynArray($T)) { a^.length = 0; }

// Makes room for at least new_cap elements. False on allocation failure,
// the array is then unchanged.
fn dyn_grow(a: ^DynArray($T), new_cap: i64, like: T): bool {
    if new_cap <= len(a^.items) { return true; }
    bigger := make_slice::<T>(new_cap, a^.allocator);
    if len(bigger) == 0 { return false; }
    if a^.length > 0 {
        bytes := cast(u64)a^.length * cast(u64)size_of(T);
        mem_copy(transmute(rawptr)&bigger[0], transmute(rawptr)&a^.items[0], bytes);
    }
    del_slice(a^.items, a^.allocator);
    a^.items = bigger;
    return true;
}

fn dyn_push(a: ^DynArray($T), v: T): bool {
    if a^.length == len(a^.items) {
        new_cap := len(a^.items) * 2;
        if new_cap == 0 { new_cap = 4; }
        if !dyn_grow(a, new_cap, v) { return false; }
    }
    a^.items[a^.length] = v;
    a^.length += 1;
    return true;
}

fn dyn_extend(a: ^DynArray($T), src: []T): bool {
    for v in src {
        if !dyn_push(a, v) { return false; }
    }
    return true;
}

// The array must not be empty.
fn dyn_pop(a: ^DynArray($T)): T {
    a^.length -= 1;
    return a^.items[a^.length];
}

// Keeps order, O(n). idx may be == length (appends).
fn dyn_insert(a: ^DynArray($T), idx: i64, v: T): bool {
    if !dyn_push(a, v) { return false; }
    i := a^.length - 1;
    while i > idx {
        a^.items[i] = a^.items[i - 1];
        i -= 1;
    }
    a^.items[idx] = v;
    return true;
}

// Keeps order, O(n).
fn dyn_remove(a: ^DynArray($T), idx: i64): T {
    removed := a^.items[idx];
    i := idx;
    while i < a^.length - 1 {
        a^.items[i] = a^.items[i + 1];
        i += 1;
    }
    a^.length -= 1;
    return removed;
}

// Order not kept, O(1).
fn dyn_swap_remove(a: ^DynArray($T), idx: i64): T {
    removed := a^.items[idx];
    a^.items[idx] = a^.items[a^.length - 1];
    a^.length -= 1;
    return removed;
}

fn dyn_free(a: ^DynArray($T)) {
    del_slice(a^.items, a^.allocator);
    empty := RawSlice{transmute(^byte)NULL, 0};
    a^.items = transmute([]T)empty;
    a^.length = 0;
}
